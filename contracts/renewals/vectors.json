{
  "$schema": "./vectors.schema.json",
  "$comment": [
    "THE RENEWAL RULE, AS DATA. Read by BOTH implementations of it:",
    "  services/platform/src/renewals.ts (the nightly fan-out that rolls next_renewal and writes payment_history)",
    "  packages/core/lib/src/dates/recurrence_schedule.dart (every app's due labels and derived next renewal)",
    "services/platform/test/renewals.test.ts and packages/core/test/recurrence_schedule_test.dart each iterate",
    "every vector below, so a change to the rule in one runtime and not the other is a red suite, not a",
    "screen that disagrees with the server. Edit a vector and BOTH suites must still pass.",
    "Dates are 'YYYY-MM-DD' in UTC. unit is day|week|month|year and every is 1..366 (the API's bound).",
    "anchorDay (month/year only) is the day of month a chain returns to after a month-end clamp; absent = the day of `from`/`next`."
  ],
  "advance": [
    {
      "from": "2026-01-15",
      "every": 1,
      "unit": "month",
      "to": "2026-02-15",
      "why": "one month in UTC"
    },
    {
      "from": "2026-12-15",
      "every": 1,
      "unit": "month",
      "to": "2027-01-15",
      "why": "month rolls the year"
    },
    {
      "from": "2026-03-10",
      "every": 1,
      "unit": "year",
      "to": "2027-03-10",
      "why": "one year"
    },
    {
      "from": "2026-01-31",
      "every": 1,
      "unit": "month",
      "to": "2026-02-28",
      "why": "month-end CLAMPS, never overflows to Mar 3 (the old setUTCMonth bug skipped February)"
    },
    {
      "from": "2026-01-31",
      "every": 1,
      "unit": "month",
      "to": "2026-02-28",
      "why": "the 31st matrix"
    },
    {
      "from": "2026-03-31",
      "every": 1,
      "unit": "month",
      "to": "2026-04-30",
      "why": "the 31st matrix"
    },
    {
      "from": "2026-04-30",
      "every": 1,
      "unit": "month",
      "to": "2026-05-30",
      "why": "the 31st matrix"
    },
    {
      "from": "2026-05-31",
      "every": 1,
      "unit": "month",
      "to": "2026-06-30",
      "why": "the 31st matrix"
    },
    {
      "from": "2026-07-31",
      "every": 1,
      "unit": "month",
      "to": "2026-08-31",
      "why": "the 31st matrix"
    },
    {
      "from": "2026-08-31",
      "every": 1,
      "unit": "month",
      "to": "2026-09-30",
      "why": "the 31st matrix"
    },
    {
      "from": "2026-10-31",
      "every": 1,
      "unit": "month",
      "to": "2026-11-30",
      "why": "the 31st matrix"
    },
    {
      "from": "2026-12-31",
      "every": 1,
      "unit": "month",
      "to": "2027-01-31",
      "why": "the 31st matrix"
    },
    {
      "from": "2026-01-30",
      "every": 1,
      "unit": "month",
      "to": "2026-02-28",
      "why": "30th into a common February"
    },
    {
      "from": "2026-01-29",
      "every": 1,
      "unit": "month",
      "to": "2026-02-28",
      "why": "29th into a common February"
    },
    {
      "from": "2024-01-30",
      "every": 1,
      "unit": "month",
      "to": "2024-02-29",
      "why": "30th into a leap February"
    },
    {
      "from": "2024-01-29",
      "every": 1,
      "unit": "month",
      "to": "2024-02-29",
      "why": "29th into a leap February"
    },
    {
      "from": "2024-01-28",
      "every": 1,
      "unit": "month",
      "to": "2024-02-28",
      "why": "no clamp needed"
    },
    {
      "from": "2024-02-29",
      "every": 1,
      "unit": "year",
      "to": "2025-02-28",
      "why": "leap day yearly clamps to Feb 28, never Mar 1"
    },
    {
      "from": "2099-02-28",
      "every": 1,
      "unit": "year",
      "to": "2100-02-28",
      "anchorDay": 29,
      "why": "2100 is not a leap year"
    },
    {
      "from": "1999-02-28",
      "every": 1,
      "unit": "year",
      "to": "2000-02-29",
      "anchorDay": 29,
      "why": "2000 was a leap year"
    },
    {
      "from": "2026-02-28",
      "every": 1,
      "unit": "month",
      "to": "2026-03-31",
      "anchorDay": 31,
      "why": "a carried anchor returns to the 31st after a clamp"
    },
    {
      "from": "2026-02-28",
      "every": 1,
      "unit": "month",
      "to": "2026-03-28",
      "why": "without the anchor it stays on the 28th"
    },
    {
      "from": "2026-03-07",
      "every": 1,
      "unit": "month",
      "to": "2026-04-07",
      "why": "UTC only: a DST week moves nothing"
    },
    {
      "from": "2026-03-08",
      "every": 1,
      "unit": "month",
      "to": "2026-04-08",
      "why": "UTC only: a DST week moves nothing"
    },
    {
      "from": "2026-03-09",
      "every": 1,
      "unit": "month",
      "to": "2026-04-09",
      "why": "UTC only: a DST week moves nothing"
    },
    {
      "from": "2026-11-01",
      "every": 1,
      "unit": "month",
      "to": "2026-12-01",
      "why": "UTC only: a DST week moves nothing"
    },
    {
      "from": "2026-09-28",
      "every": 1,
      "unit": "week",
      "to": "2026-10-05",
      "why": "weekly"
    },
    {
      "from": "2026-12-28",
      "every": 1,
      "unit": "week",
      "to": "2027-01-04",
      "why": "weekly across the year end"
    },
    {
      "from": "2024-02-26",
      "every": 1,
      "unit": "week",
      "to": "2024-03-04",
      "why": "weekly across a leap February"
    },
    {
      "from": "2026-09-28",
      "every": 2,
      "unit": "week",
      "to": "2026-10-12",
      "why": "fortnightly"
    },
    {
      "from": "2026-01-31",
      "every": 3,
      "unit": "month",
      "to": "2026-04-30",
      "why": "quarterly clamps to a 30-day month"
    },
    {
      "from": "2026-11-30",
      "every": 3,
      "unit": "month",
      "to": "2027-02-28",
      "why": "quarterly across the year end into February"
    },
    {
      "from": "2026-10-15",
      "every": 3,
      "unit": "month",
      "to": "2027-01-15",
      "why": "quarterly"
    },
    {
      "from": "2026-12-31",
      "every": 6,
      "unit": "month",
      "to": "2027-06-30",
      "why": "half-yearly"
    },
    {
      "from": "2026-09-28",
      "every": 10,
      "unit": "day",
      "to": "2026-10-08",
      "why": "every 10 days"
    },
    {
      "from": "2026-02-25",
      "every": 10,
      "unit": "day",
      "to": "2026-03-07",
      "why": "every 10 days across a common February"
    },
    {
      "from": "2024-02-25",
      "every": 10,
      "unit": "day",
      "to": "2024-03-06",
      "why": "every 10 days across a leap February"
    },
    {
      "from": "2026-12-31",
      "every": 1,
      "unit": "day",
      "to": "2027-01-01",
      "why": "daily across the year end"
    },
    {
      "from": "2026-03-01",
      "every": 30,
      "unit": "day",
      "to": "2026-03-31",
      "why": "every 30 days is not monthly"
    },
    {
      "from": "2024-02-29",
      "every": 2,
      "unit": "year",
      "to": "2026-02-28",
      "why": "every 2 years from a leap day"
    },
    {
      "from": "2024-02-29",
      "every": 4,
      "unit": "year",
      "to": "2028-02-29",
      "why": "every 4 years lands on the next leap day"
    },
    {
      "from": "2026-05-10",
      "every": 3,
      "unit": "year",
      "to": "2029-05-10",
      "why": "every 3 years"
    },
    {
      "from": "2026-12-31",
      "every": 13,
      "unit": "month",
      "to": "2028-01-31",
      "why": "13 months crosses a year and a month"
    },
    {
      "from": "2026-06-15",
      "every": 24,
      "unit": "month",
      "to": "2028-06-15",
      "why": "24 months is two years"
    }
  ],
  "rollForward": [
    {
      "next": "2026-07-25",
      "every": 1,
      "unit": "month",
      "today": "2026-07-21",
      "expectNext": "2026-07-25",
      "crossings": [],
      "why": "nothing crossed when already in the future"
    },
    {
      "next": "2026-07-21",
      "every": 1,
      "unit": "month",
      "today": "2026-07-21",
      "expectNext": "2026-07-21",
      "crossings": [],
      "why": "due TODAY is not crossed: the charge has not happened yet"
    },
    {
      "next": "2026-05-10",
      "every": 1,
      "unit": "month",
      "today": "2026-07-21",
      "expectNext": "2026-08-10",
      "crossings": [
        "2026-05-10",
        "2026-06-10",
        "2026-07-10"
      ],
      "why": "past due rolls, one crossing per charge"
    },
    {
      "next": "2024-02-01",
      "every": 1,
      "unit": "year",
      "today": "2026-07-21",
      "expectNext": "2027-02-01",
      "crossings": [
        "2024-02-01",
        "2025-02-01",
        "2026-02-01"
      ],
      "why": "yearly"
    },
    {
      "next": "2026-01-31",
      "every": 1,
      "unit": "month",
      "today": "2026-07-31",
      "expectNext": "2026-07-31",
      "crossings": [
        "2026-01-31",
        "2026-02-28",
        "2026-03-31",
        "2026-04-30",
        "2026-05-31",
        "2026-06-30"
      ],
      "why": "a 31st anchor crosses EVERY month and keeps the 31st"
    },
    {
      "next": "2024-02-29",
      "every": 1,
      "unit": "year",
      "today": "2028-01-01",
      "expectNext": "2028-02-29",
      "crossings": [
        "2024-02-29",
        "2025-02-28",
        "2026-02-28",
        "2027-02-28"
      ],
      "why": "leap day clamps, then recovers on the next leap year"
    },
    {
      "next": "2026-02-28",
      "every": 1,
      "unit": "month",
      "today": "2026-03-01",
      "expectNext": "2026-03-28",
      "crossings": [
        "2026-02-28"
      ],
      "why": "KNOWN RESIDUAL: the anchor is read from the stored date, so a clamped 28th stays a 28th"
    },
    {
      "next": "2026-02-28",
      "every": 1,
      "unit": "month",
      "today": "2026-03-01",
      "expectNext": "2026-03-31",
      "crossings": [
        "2026-02-28"
      ],
      "anchorDay": 31,
      "why": "a caller that knows the anchor passes it"
    },
    {
      "next": "2026-09-01",
      "every": 1,
      "unit": "week",
      "today": "2026-09-28",
      "expectNext": "2026-09-29",
      "crossings": [
        "2026-09-01",
        "2026-09-08",
        "2026-09-15",
        "2026-09-22"
      ],
      "why": "weekly: every crossing is a charge"
    },
    {
      "next": "2026-09-10",
      "every": 10,
      "unit": "day",
      "today": "2026-10-01",
      "expectNext": "2026-10-10",
      "crossings": [
        "2026-09-10",
        "2026-09-20",
        "2026-09-30"
      ],
      "why": "every 10 days"
    },
    {
      "next": "2026-01-31",
      "every": 3,
      "unit": "month",
      "today": "2026-09-28",
      "expectNext": "2026-10-31",
      "crossings": [
        "2026-01-31",
        "2026-04-30",
        "2026-07-31"
      ],
      "why": "quarterly keeps its 31st anchor"
    },
    {
      "next": "2020-06-15",
      "every": 2,
      "unit": "year",
      "today": "2026-09-28",
      "expectNext": "2028-06-15",
      "crossings": [
        "2020-06-15",
        "2022-06-15",
        "2024-06-15",
        "2026-06-15"
      ],
      "why": "every 2 years"
    }
  ]
}
