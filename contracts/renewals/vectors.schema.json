{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nikatru.com/contracts/renewals/vectors.schema.json",
  "title": "Renewal schedule vectors",
  "description": "The shared examples both implementations of the renewal rule are tested against. See README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["advance", "rollForward"],
  "$defs": {
    "ymd": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "every": { "type": "integer", "minimum": 1, "maximum": 366 },
    "unit": { "enum": ["day", "week", "month", "year"] },
    "anchorDay": { "type": "integer", "minimum": 1, "maximum": 31 },
    "why": { "type": "string", "minLength": 1 }
  },
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "array", "items": { "type": "string" } },
    "advance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "every", "unit", "to"],
        "properties": {
          "from": { "$ref": "#/$defs/ymd" },
          "every": { "$ref": "#/$defs/every" },
          "unit": { "$ref": "#/$defs/unit" },
          "anchorDay": { "$ref": "#/$defs/anchorDay" },
          "to": { "$ref": "#/$defs/ymd" },
          "why": { "$ref": "#/$defs/why" }
        }
      }
    },
    "rollForward": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["next", "every", "unit", "today", "expectNext", "crossings"],
        "properties": {
          "next": { "$ref": "#/$defs/ymd" },
          "every": { "$ref": "#/$defs/every" },
          "unit": { "$ref": "#/$defs/unit" },
          "anchorDay": { "$ref": "#/$defs/anchorDay" },
          "today": { "$ref": "#/$defs/ymd" },
          "expectNext": { "$ref": "#/$defs/ymd" },
          "crossings": { "type": "array", "items": { "$ref": "#/$defs/ymd" } },
          "why": { "$ref": "#/$defs/why" }
        }
      }
    }
  }
}
