  "updateRequiredTitle": "Update required",
  "@updateRequiredTitle": {
    "description": "Heading on the force-update wall. THE WALL REPLACES THE WHOLE APP when the running version falls below the supported floor, so this is the only text on screen and there is no way past it. Until 2026-09-04 no key existed and ForceUpdateGate's English parameter default shipped to every locale."
  },
  "updateRequiredMessage": "This version is no longer supported. Please update to keep using the app.",
  "@updateRequiredMessage": {
    "description": "Body of the force-update wall. Says WHY the app stopped and WHAT to do, because the user cannot reach anything else to find out. Names no version number: the floor is served from config and a number baked into a translation would go stale silently."
  },
  "updateRequiredAction": "Update now",
  "@updateRequiredAction": {
    "description": "The only control on the force-update wall. Opens the store listing. Hidden when the app has no update URL to send the user to, so the wall still blocks rather than offering a dead button."
  },
  "paywallHeadline": "Unlock the full experience",
  "@paywallHeadline": {
    "description": "Paywall heading, also used as the in-place PaywallGate title. CHASSIS DEFAULT — a freshly stamped app that has overridden nothing shows this, so it must not promise a feature the chassis does not have."
  },
  "paywallUpgrade": "Upgrade",
  "@paywallUpgrade": {
    "description": "The call to action that opens the checkout."
  },
  "paywallOpening": "Opening the secure checkout in your browser…",
  "@paywallOpening": {
    "description": "Shown while the hosted checkout is being handed to the platform. Names the BROWSER deliberately: the page opens outside the app, and a user who is not told that reads the app-switch as a crash."
  },
  "paywallPending": "Your payment is being confirmed. This can take a moment — nothing more is needed from you.",
  "@paywallPending": {
    "description": "🔴 MUST NEVER READ AS A FAILURE. The user may well have paid; the merchant of record's notification simply has not reached our server yet. Saying 'purchase failed' here tells a paying customer their money vanished. WORDING IS A HUMAN DECISION — a green CI lane proves the mechanism, not this sentence."
  },
  "paywallCheckAgain": "Check again",
  "@paywallCheckAgain": {
    "description": "Re-reads the entitlement from the server. Present because the automatic wait is BOUNDED — five attempts over about a minute — and a user whose purchase lands after that needs something to press other than the back button."
  },
  "paywallUnlocked": "You are all set. Thank you.",
  "@paywallUnlocked": {
    "description": "Shown only after the SERVER confirms the entitlement, never on the checkout's return."
  },
  "paywallUnavailable": "Purchases are not available here.",
  "@paywallUnavailable": {
    "description": "Shown when the rail is unconfigured, or when the store this build ships through forbids an external checkout. The specific reason is shown beneath it — a refusal with no reason is indistinguishable from a broken button."
  },
  "paywallTerm": "Billed per {term}",
  "@paywallTerm": {
    "description": "The billing period, from the rail config. NOT a price — the price is formatted from the rail's own amount and currency and is never typed into the app.",
