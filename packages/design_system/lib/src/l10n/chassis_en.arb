  "deleteAccountReauthHint": "Enter your password to confirm it is you.",
  "@deleteAccountReauthHint": {
    "description": "Explains why a password is required to delete the account."
  },
  "deleteAccountConfirmBodyApple": "This cannot be undone. Deleting removes your sign-in, so Sign in with Apple will no longer open this account.",
  "@deleteAccountConfirmBodyApple": {
    "description": "O-OAUTH-DELETE-REAUTH, owner-approved 2026-09-16. The delete confirmation body for a PASSWORD-LESS account (Sign in with Apple). Replaces deleteAccountConfirmBody, which names an email and password this account does not have."
  },
  "deleteAccountReauthHintApple": "To confirm it's you, you'll sign in with Apple again when you tap Delete account. On the web, if you land back here, tap Delete account once more.",
  "@deleteAccountReauthHintApple": {
    "description": "O-OAUTH-DELETE-REAUTH, owner-approved 2026-09-16. Shown instead of the password field for a password-less account: deletion is confirmed by signing in with Apple again. The second sentence covers web, where Apple's full-page redirect reloads the app before the deletion can run."
  },
  "deleteAccountFailed": "Could not delete your account. Your account has NOT been deleted.",
  "@deleteAccountFailed": {
    "description": "Shown when deletion fails with nothing removed. Must state plainly that nothing was deleted."
  },
  "deleteAccountNotConfigured": "Nothing was deleted. This app cannot complete an account deletion yet, so the request was refused rather than carried out in part. Your account and your data are unchanged.",
  "@deleteAccountNotConfigured": {
    "description": "The 501 answer: the server cannot remove the identity record, so it refused BEFORE deleting anything. Must not state a turnaround time, a retention period or a legal basis — the published deletion page states none."
  },
  "deleteAccountSignInSurvives": "Your data was deleted, but your sign-in was not: the same email and password can still sign in. The deletion is incomplete.",
  "@deleteAccountSignInSurvives": {
    "description": "The 502 answer: rows purged, identity delete failed. Must NOT say nothing was deleted — the data really is gone and only the login survived."
  },
  "deleteAccountPending": "Your deletion request was accepted but isn't finished yet. Some of your data couldn't be removed right away. We'll keep trying automatically, and your sign-in is removed last.",
  "@deleteAccountPending": {
    "description": "ADR 081, 2026-09-15: the 202 erasure_pending answer. Accepted, not finished: an app could not be reached, its data and the sign-in are removed later automatically. Must NOT say the account is deleted, and must state no turnaround time."
  },
  "deleteAccountUnknown": "We could not confirm what happened to your account. Do not assume it has been deleted.",
  "@deleteAccountUnknown": {
    "description": "No response, or a status the contract does not model. How far the deletion got is unknown, so nothing is claimed either way."
  },
