diff --git a/apps/subscriptiontracker/android/app/src/main/kotlin/com/nikatru/subscriptiontracker/GlanceWidgetProvider.kt b/apps/subscriptiontracker/android/app/src/main/kotlin/com/nikatru/subscriptiontracker/GlanceWidgetProvider.kt
