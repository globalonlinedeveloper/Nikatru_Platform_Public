+import 'package:http/http.dart' as http;
+import 'package:nikatru_core/nikatru_core.dart' as core;
+
+/// ⏱ 2026-10-01 · EN-22 — the `package:http` client every GoTrue client this
+/// package builds sends through, so a 429's `Retry-After` reaches the screen.
+///
+/// 🔴 WHY A TRANSPORT AND NOT THE EXCEPTION. gotrue-dart 2.26.0 throws
+/// `AuthApiException(message, statusCode, code)` and drops the response
+/// headers on the floor, so by the time the adapter catches a rate-limit
+/// refusal the wait is gone. The transport is the last place that sees it:
+/// this records the newest 429's wait, and the adapter's `_failureOf` [take]s
+/// it into the [core.AuthFailure] it throws.
+///
+/// One recorder per process ([nikatruRetryAfter]), shared by the main and the
+/// native client, because a refusal from either is answered by the same catch.
+class RetryAfterRecorder extends http.BaseClient {
+  RetryAfterRecorder({http.Client? inner, DateTime Function()? clock})
+    : _inner = inner,
+      _now = clock ?? (() => DateTime.now().toUtc());
+
+  http.Client? _inner;
+  final DateTime Function() _now;
+
+  Duration? _wait;
+  DateTime? _at;
+
+  /// How long a recorded wait stays claimable. The catch that reads it runs in
+  /// the same microtask chain as the response, so anything older belongs to
+  /// another request.
+  static const Duration freshFor = Duration(seconds: 10);
+
+  /// The transport this records for. Settable once, so a client built before
+  /// the recorder knows its transport (the native client) can hand it in.
+  http.Client get inner => _inner ??= http.Client();
+  set inner(http.Client client) => _inner = client;
+
+  @override
+  Future<http.StreamedResponse> send(http.BaseRequest request) async {
+    final http.StreamedResponse res = await inner.send(request);
+    if (res.statusCode == 429) record(res.headers['retry-after']);
+    return res;
+  }
+
+  /// Records the wait [header] asks for; an unreadable header records nothing.
+  void record(String? header) {
+    final DateTime now = _now();
+    final Duration? wait = core.parseRetryAfter(header, now: now);
+    if (wait == null) return;
+    _wait = wait;
+    _at = now;
+  }
+
+  /// The newest wait, if it is fresh, and forgets it — a wait is claimed by
+  /// one refusal, never shown twice.
+  Duration? take() {
+    final Duration? wait = _wait;
+    final DateTime? at = _at;
+    _wait = null;
+    _at = null;
+    if (wait == null || at == null) return null;
+    return _now().difference(at) > freshFor ? null : wait;
+  }
+
+  /// 🔴 A NO-OP, ON PURPOSE. The process's recorder is handed to more than one
+  /// GoTrue client, and the first of them to be disposed would otherwise close
+  /// the transport under the rest.
+  @override
+  void close() {}
+}
+
+/// The process's one recorder — see [RetryAfterRecorder].
+final RetryAfterRecorder nikatruRetryAfter = RetryAfterRecorder();
