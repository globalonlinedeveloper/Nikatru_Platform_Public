+      webInrMinor,
+      rails: { paddle: { pending: 'fixture', taxMode: paddle }, razorpay: { pending: 'fixture', taxMode: razorpay } },
+    });
+    return { apps: { subscriptiontracker: { pro_monthly: entry(14900), pro_yearly: entry(149900) } } };
+  };
