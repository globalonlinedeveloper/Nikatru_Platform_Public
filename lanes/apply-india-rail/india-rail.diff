+          '<!-- PRICING:products -->\n<!-- /PRICING:products -->\n' +
+          '  <!-- PRICING:india -->\n  <!-- /PRICING:india -->\n  ' + TAX_PAIR,
+      ),
+    );
+    writeFileSync(p(root, 'terms.html'), chromed('<h1>Terms</h1>\n  ' + TAX_PAIR));
+    return root;
+  };
