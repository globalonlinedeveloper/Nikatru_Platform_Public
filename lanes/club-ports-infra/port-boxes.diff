diff --git a/tooling/boxes/backups.json b/tooling/boxes/backups.json
new file mode 100644
index 00000000..8b4f4e37
--- /dev/null
+++ b/tooling/boxes/backups.json
@@ -0,0 +1,74 @@
+{
+  "_why": [
+    "THE BACKUP DESTINATIONS AS DATA, each set with a restore drill. Read by tooling/ops/restore-drill.mjs (one named small file from the newest snapshot into a scratch directory, hashed against the hash the SOURCE recorded, then deleted), by tooling/ops/box-move.mjs (the backups to restore first, with a drill command each) and by tooling/ops/check-box-declared.mjs (`readBack`: the snapshot count and the newest timestamp of a repository that lives on a box).",
+    "TRAP backup-04: a restructure that renames AND relayouts gets half-applied, so every destination declares BOTH its remote NAME and its LAYOUT. A `<NAME>` inside a remote or repository is an environment variable the operator sets from the vault; the drill reports LOST when it is unset and never prints its value.",
+    "TRAP backup-06: a same-day re-run of a date-stamped backup replaces that day's artefact, so the drill READS and never runs a backup. Restic is always called with --no-lock (a lock is a write to the repository).",
+    "The encryption posture is cited per destination ([ADR 021], [ADR 046], [ADR 047], [ADR 060]); the facts are those of tooling/ops/register.json rows duty.restic-snapshot, duty.restic-third-copy, duty.cloudflare-backup-pull and duty.supabase-dump, cited by id, not restated beyond the name and the layout.",
+    "A field the public tree does not state is null. A drill whose `file` or `hash` is null is LOST, by design: naming the small file and where its hash was recorded is the first drill's work, never a guess."
+  ],
+  "destinations": [
+    { "id": "boxb-srv-restic", "kind": "restic", "box": "boxb", "remote": { "name": null, "layout": "/srv/restic" }, "repo": "/srv/restic", "env": [], "encryption": { "posture": "restic's own repository encryption; the repository key never leaves the box", "adr": ["046"] } },
+    { "id": "drive-restic-boxb", "kind": "restic", "box": null, "remote": { "name": "oracleenc", "layout": "restic-boxb" }, "repo": "rclone:oracleenc:restic-boxb", "env": [["RESTIC_PASSWORD_FILE", "RESTIC_PASSWORD"]], "encryption": { "posture": "restic's repository key inside the rclone crypt `oracleenc:` on the company Drive: the provider holds ciphertext twice over", "adr": ["021", "046", "047"] } },
+    { "id": "r2-restic-boxb", "kind": "restic", "box": null, "remote": { "name": "s3:<R2_S3_ENDPOINT>", "layout": "nikatru-backups/restic-boxb" }, "repo": "s3:<R2_S3_ENDPOINT>/nikatru-backups/restic-boxb", "env": [["RESTIC_PASSWORD_FILE", "RESTIC_PASSWORD"], "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "R2_S3_ENDPOINT"], "encryption": { "posture": "restic's repository key over R2 (restic's native S3 backend: rclone serve restic --stdio is refused by R2 with 501)", "adr": ["021", "046"] } },
+    { "id": "oci-thirdcopy", "kind": "restic", "box": "boxa", "remote": { "name": "ocienc", "layout": null }, "repo": "rclone:ocienc:<OCI_THIRDCOPY_PATH>", "env": [["RESTIC_PASSWORD_FILE", "RESTIC_PASSWORD"], "OCI_THIRDCOPY_PATH"], "encryption": { "posture": "a byte copy of /srv/restic through the rclone crypt `ocienc:` (the same obscured key as `oracleenc:`) into the versioned OCI bucket nikatru-backup-thirdcopy; the box's credential holds no delete right", "adr": ["060"] } },
+    { "id": "r2-nikatru-backups", "kind": "rclone-manifest", "box": null, "remote": { "name": "<R2_RCLONE_REMOTE>", "layout": "nikatru-backups: manifests/latest.json, d1/<db>/<date>.jsonl.gz, kv/<namespace>/<date>.json.gz" }, "base": "<R2_RCLONE_REMOTE>:nikatru-backups", "env": ["R2_RCLONE_REMOTE"], "encryption": { "posture": "no client-side encryption is declared for the objects: the export is gzip inside Cloudflare, and the off-vendor copy (drive-cloudflare) is the encrypted one", "adr": ["021"] } },
+    { "id": "drive-cloudflare", "kind": "rclone-dated", "box": null, "remote": { "name": "oracleenc", "layout": "cloudflare/<date>/" }, "base": "oracleenc:cloudflare", "env": [], "encryption": { "posture": "the rclone crypt `oracleenc:` on the company Drive", "adr": ["021", "046", "047"] } },
+    { "id": "boxb-glitchtip-dumps", "kind": "box-dir", "box": "boxb", "remote": { "name": null, "layout": "/opt/glitchtip/backups" }, "env": [], "encryption": { "posture": "plaintext on the box's own disk; the off-box copies are the encrypted ones", "adr": ["021"] } },
+    { "id": "drive-glitchtip", "kind": "rclone-dated", "box": null, "remote": { "name": null, "layout": null }, "base": null, "env": [], "encryption": { "posture": "the Drive sync of gt_drive_sync.sh (duty.oci.gt-drive-sync); its remote name and layout are not stated in the public tree", "adr": ["046", "047"] } },
+    { "id": "boxc-supabase-dumps", "kind": "box-dir", "box": "boxc", "remote": { "name": null, "layout": "/opt/supabase/backups" }, "env": [], "encryption": { "posture": "plaintext on the box's own disk; the off-box copies are the encrypted ones", "adr": ["021"] } },
+    { "id": "drive-supabase", "kind": "rclone-dated", "box": null, "remote": { "name": null, "layout": null }, "base": null, "env": [], "encryption": { "posture": "the Drive sync of sb_drive_sync.sh (duty.supabase-drive-sync); its remote name and layout are not stated in the public tree", "adr": ["046", "047"] } },
+    { "id": "boxb-supabase-second-copy", "kind": "box-dir", "box": "boxb", "remote": { "name": null, "layout": null }, "env": [], "encryption": { "posture": "the second copy sb_boxb_sync.sh pushes to Box B (duty.supabase-second-copy); its path is not stated in the public tree", "adr": ["021"] } }
+  ],
+  "sets": [
+    {
+      "id": "boxb-restic",
+      "box": "boxb",
+      "writer": "duty.restic-snapshot",
+      "what": "The seven paths of /opt/backup/restic-sets.txt on Box B, after sqlite-snapshot.py, tagged boxb,daily.",
+      "destinations": ["boxb-srv-restic", "drive-restic-boxb", "r2-restic-boxb"],
+      "retention": "Sundays: forget --keep-daily 14 --keep-weekly 8 --keep-monthly 6 --prune on all three repositories",
+      "readBack": { "destination": "boxb-srv-restic", "passwordFile": null },
+      "drill": { "from": "r2-restic-boxb", "file": null, "hash": "restic-tree", "tag": "boxb" }
+    },
+    {
+      "id": "restic-third-copy",
+      "box": "boxb",
+      "writer": "duty.restic-third-copy",
+      "what": "An rclone copy of /srv/restic into the OCI Object Storage bucket through `ocienc:`; a superset of /srv/restic (the weekly prune does not reach it).",
+      "destinations": ["oci-thirdcopy"],
+      "retention": "none upstream: the copy only grows; reconciling it is a deliberate act with the tenancy admin key",
+      "readBack": null,
+      "drill": { "from": "oci-thirdcopy", "file": null, "hash": "restic-tree", "tag": "boxb" }
+    },
+    {
+      "id": "glitchtip-pg",
+      "box": "boxb",
+      "writer": "duty.oci.glitchtip-pg-dump",
+      "what": "The nightly pg_dump of GlitchTip's database, then its Drive sync (duty.oci.gt-drive-sync).",
+      "destinations": ["boxb-glitchtip-dumps", "drive-glitchtip"],
+      "retention": null,
+      "readBack": null,
+      "drill": { "from": "drive-glitchtip", "file": null, "hash": null }
+    },
+    {
+      "id": "supabase-auth-pg",
+      "box": "boxc",
+      "writer": "duty.supabase-dump",
+      "what": "Four artefacts every six hours: the globals, the postgres and _supabase databases, and the pgsodium root key; then the Drive sync and the second copy to Box B.",
+      "destinations": ["boxc-supabase-dumps", "drive-supabase", "boxb-supabase-second-copy"],
+      "retention": "14 days on the box (duty.supabase-dump prunes)",
+      "readBack": null,
+      "drill": { "from": "drive-supabase", "file": null, "hash": null }
+    },
+    {
+      "id": "d1-kv-export",
+      "box": null,
+      "writer": "duty.platform-cron",
+      "what": "The nightly D1 and KV export the platform Worker writes to R2 (services/platform/src/backup/index.ts), with a manifest that records every object's SHA-256; Box B's cf_backup_pull.sh copies it off-vendor (duty.cloudflare-backup-pull).",
+      "destinations": ["r2-nikatru-backups", "drive-cloudflare"],
+      "retention": "R2: the Worker's retentionDays (isExpired in services/platform/src/backup/index.ts); the Drive copy: 35 days",
+      "readBack": null,
+      "drill": { "from": "r2-nikatru-backups", "file": "kv/platform-jwks/{date}.json.gz", "hash": "manifest", "manifest": "manifests/latest.json" }
+    }
+  ]
+}
diff --git a/tooling/boxes/boxa.json b/tooling/boxes/boxa.json
new file mode 100644
index 00000000..873fb885
--- /dev/null
+++ b/tooling/boxes/boxa.json
@@ -0,0 +1,26 @@
+{
+  "box": "boxa",
+  "_why": [
+    "BOX A — the Oracle Cloud VM and its tenancy. Wiped of the platform on 2026-09-24 (the auth stack moved to Box C) and kept for non-platform use; the tenancy's Object Storage holds the encrypted third copy of the restic repositories (duty.restic-third-copy, [ADR 060]), which is the role this box holds: `backup-leg`.",
+    "O-BOXA-TRACKED-COPIES-UNGUARDED found a tracked copy of this box's state that omitted what the box runs. This declaration is the copy, and tooling/ops/check-box-declared.mjs is its guard: anything running that is not declared here is drift (exit 1).",
+    "The declaration is deliberately near-empty: since 2026-09-24 the platform runs nothing on this VM. The one sanctioned exception before the move was a Beszel agent bound to the WireGuard address (tooling/monitor-register.json `_notInThisRegister`); whether it still runs is the first read-back's to say. A field the public tree does not state is null and is reported UNREAD (LOST)."
+  ],
+  "roles": ["backup-leg"],
+  "provider": { "vendor": "oracle-cloud", "plan": "pay-as-you-go", "product": "Compute VM and Object Storage (ap-mumbai-1)" },
+  "cost": { "source": "Private/platform-state/identity.json", "vendorId": "oracle-cloud", "why": "Cited by vendor id, never copied: CI cannot read Private, so box-move grades the cost delta LOST there." },
+  "spec": { "cpu": null, "ramGiB": null, "diskGiB": null, "asOf": "2026-10-01", "verify": "check-box-declared.mjs reads nproc, free -b and df -B1 /; the shape is not stated in the public tree" },
+  "ssh": { "hostEnv": "BOXA_SSH_HOST", "userEnv": "BOXA_SSH_USER", "keyEnv": "BOXA_SSH_KEY", "portEnv": "BOXA_SSH_PORT", "sudoEnv": "BOXA_SSH_SUDO" },
+  "cronTz": { "value": null, "measuredOn": null, "by": "timedatectl", "cite": "tooling/ops/register.json#duty.supabase-dump", "carried": "Box A ran Asia/Kolkata on 2026-09-06; after the wipe nothing in the public tree says what it runs now" },
+  "services": [],
+  "units": ["cron", "ssh"],
+  "volumes": [],
+  "backupSets": ["restic-third-copy"],
+  "hostnames": [],
+  "tunnel": null,
+  "monitors": [41],
+  "crons": [],
+  "allowLists": [],
+  "_toConfirm": [
+    "Read back on the first run and fill: the timezone, the shape (nproc, RAM, disk), every running unit and any container. If the Beszel agent still runs here, declare it in `units` or retire it — an undeclared one is drift."
+  ]
+}
diff --git a/tooling/boxes/boxb.json b/tooling/boxes/boxb.json
new file mode 100644
index 00000000..f2f36063
--- /dev/null
+++ b/tooling/boxes/boxb.json
@@ -0,0 +1,60 @@
+{
+  "box": "boxb",
+  "_why": [
+    "BOX B — the operations box. What it runs, declared as DATA and read back by tooling/ops/check-box-declared.mjs (READ-ONLY over SSH: exit 1 on drift, 2 when it could not look). Until this file, what the box runs was spread across Private runbooks, tooling/ops/register.json, tooling/monitor-register.json, tooling/ops/alarm-chains.json and the box itself (row O-BOXES-NOT-DECLARED-AS-DATA).",
+    "Every value here is either a name, a schedule, a version, or a CITATION of the register that owns the fact (monitors by id, crons by register row, backup sets by tooling/boxes/backups.json id, cost by Private vendor id). No address is ever written here: the box is reached through the environment names under `ssh`, which the operator fills from the vault.",
+    "Sources read for the first draft (2026-10-01): tooling/monitor-register.json `_notInThisRegister` (the hostnames and versions), tooling/ops/register.json (the crons, their schedules and the timezone), tooling/ops/alarm-chains.json `expectedMonitors` (the heartbeat ids). A field the public tree does not state is null, and the read-back reports it as UNREAD (LOST) until the first read fills it — never a guess presented as a measurement."
+  ],
+  "roles": ["ops"],
+  "provider": { "vendor": "hostinger", "plan": "KVM 8", "product": "VPS" },
+  "cost": { "source": "Private/platform-state/identity.json", "vendorId": "hostinger", "why": "Cited by vendor id, never copied: CI cannot read Private, so box-move grades the cost delta LOST there." },
+  "spec": { "cpu": 8, "ramGiB": 32, "diskGiB": 400, "asOf": "2026-10-01", "verify": "check-box-declared.mjs reads nproc, free -b and df -B1 / and compares (RAM and disk within 15% below the plan's figure)" },
+  "ssh": { "hostEnv": "BOXB_SSH_HOST", "userEnv": "BOXB_SSH_USER", "keyEnv": "BOXB_SSH_KEY", "portEnv": "BOXB_SSH_PORT", "sudoEnv": "BOXB_SSH_SUDO" },
+  "cronTz": { "value": "Etc/UTC", "measuredOn": "2026-09-03", "by": "timedatectl", "cite": "tooling/ops/register.json#duty.cloudflare-backup-pull" },
+  "services": [
+    { "id": "glitchtip", "image": "glitchtip/glitchtip", "version": "6.2.6", "compose": { "project": "glitchtip", "service": null }, "containers": 2, "hostnames": ["glitchtip.nikatru.com"], "secrets": ["SECRET_KEY", "DATABASE_URL", "EMAIL_URL"], "use": null },
+    { "id": "glitchtip-postgres", "image": "postgres", "version": null, "compose": { "project": "glitchtip", "service": null }, "containers": 1, "hostnames": [], "secrets": ["POSTGRES_PASSWORD"], "use": null },
+    { "id": "glitchtip-cache", "image": "valkey/valkey", "version": null, "compose": { "project": "glitchtip", "service": null }, "containers": 1, "hostnames": [], "secrets": [], "use": null },
+    { "id": "vaultwarden", "image": "vaultwarden/server", "version": "1.37.2", "compose": { "project": null, "service": null }, "containers": 1, "hostnames": ["vault.nikatru.com"], "secrets": ["ADMIN_TOKEN"], "use": null },
+    { "id": "ntfy", "image": "binwiederhier/ntfy", "version": "2.28.0", "compose": { "project": null, "service": null }, "containers": 1, "hostnames": ["ntfy.nikatru.com"], "secrets": [], "use": null },
+    { "id": "beszel-hub", "image": "henrygd/beszel", "version": "0.19.0", "compose": { "project": null, "service": null }, "containers": 1, "hostnames": ["beszel.nikatru.com"], "secrets": [], "use": null },
+    { "id": "dozzle", "image": "amir20/dozzle", "version": "10.9.2", "compose": { "project": null, "service": null }, "containers": 1, "hostnames": ["logs.nikatru.com"], "secrets": [], "use": null },
+    { "id": "diun", "image": "crazymax/diun", "version": "4.33.0", "compose": { "project": "diun", "service": null }, "containers": 1, "hostnames": [], "secrets": [], "use": null }
+  ],
+  "units": ["docker", "containerd", "cron", "ssh", "beszel-agent"],
+  "volumes": [
+    { "name": "/opt/glitchtip", "kind": "bind", "holds": "the GlitchTip compose project and its nightly dumps (backups/)", "backupSets": ["glitchtip-pg", "boxb-restic"] },
+    { "name": "/opt/backup", "kind": "bind", "holds": "the restic run, its set list (restic-sets.txt) and the third-copy scripts", "backupSets": ["boxb-restic"] },
+    { "name": "/opt/diun", "kind": "bind", "holds": "Diun's configuration and its run log", "backupSets": ["boxb-restic"] },
+    { "name": "/srv/restic", "kind": "bind", "holds": "the LOCAL restic repository (one of three)", "backupSets": ["restic-third-copy"] }
+  ],
+  "backupSets": ["boxb-restic", "glitchtip-pg", "d1-kv-export", "restic-third-copy", "supabase-auth-pg"],
+  "hostnames": [
+    { "name": "glitchtip.nikatru.com", "record": "tunnel-cname", "via": "the Box B Cloudflare tunnel" },
+    { "name": "vault.nikatru.com", "record": "tunnel-cname", "via": "the Box B Cloudflare tunnel" },
+    { "name": "ntfy.nikatru.com", "record": "tunnel-cname", "via": "the Box B Cloudflare tunnel" },
+    { "name": "beszel.nikatru.com", "record": "tunnel-cname", "via": "the Box B Cloudflare tunnel" },
+    { "name": "logs.nikatru.com", "record": "tunnel-cname", "via": "the Box B Cloudflare tunnel" }
+  ],
+  "tunnel": { "secret": "TUNNEL_TOKEN", "why": "Every hostname is a CNAME to one Cloudflare tunnel, no public port opened (tooling/monitor-register.json `_notInThisRegister`): the records do not change in a move; the connector runs on the target with this secret." },
+  "monitors": [1, 31, 32, 39, 16, 22, 23, 38, 41],
