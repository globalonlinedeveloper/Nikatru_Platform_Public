+    { "name": "cloudflare-backup-pull", "schedule": "45 2 * * *", "script": "/opt/glitchtip/cf_backup_pull.sh", "register": "duty.cloudflare-backup-pull" },
+    { "name": "restic-snapshot", "schedule": "0 4 * * *", "script": "/opt/backup/restic-run.sh", "register": "duty.restic-snapshot" },
+    { "name": "restic-liveness", "schedule": null, "script": "/opt/backup/restic-liveness.sh", "register": "duty.restic-snapshot" },
+    { "name": "restic-third-copy", "schedule": "0 5 * * *", "script": "/opt/backup/06-oci-third-copy.sh", "register": "duty.restic-third-copy" },
+    { "name": "restic-third-copy-liveness", "schedule": null, "script": "/opt/backup/07-oci-third-copy-liveness.sh", "register": "duty.restic-third-copy" },
+    { "name": "diun-liveness", "schedule": "23 * * * *", "script": "/opt/diun/diun-liveness.sh", "register": "duty.boxb.diun" }
+  ],
+  "allowLists": [
+    { "id": "apisetu-key-ip-whitelist", "where": "the API Setu partner console: the IP whitelist on the platform's API key", "owner": "owner", "row": "O-APISETU-KEY-IP-WHITELIST", "verify": "read the key's whitelist in the API Setu console and compare it to the declared address", "confirmedOn": null },
+    { "id": "boxc-admits-boxb", "where": "Box C's firewall and sshd: the second-copy sync and the Beszel agent are reached from this box's address", "owner": "operator", "row": null, "verify": "on Box C, read the firewall rules (ufw status / nft list ruleset) for the declared address", "confirmedOn": null }
+  ],
+  "_toConfirm": [
+    "Read back on the first run and fill, never guess: the compose project names of vaultwarden, ntfy, beszel-hub and dozzle; the image and version of GlitchTip's database and cache; the minutes of the two hourly liveness crons; every OS unit beyond the five named; every named docker volume. `node tooling/ops/check-box-declared.mjs boxb --print-observed` prints what was read, names only."
+  ]
+}
diff --git a/tooling/boxes/boxc.json b/tooling/boxes/boxc.json
