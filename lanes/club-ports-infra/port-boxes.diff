@@ -0,0 +1,46 @@
+{
+  "box": "boxc",
+  "_why": [
+    "BOX C — the auth box: the self-hosted GoTrue and its Postgres since 2026-09-24 (Box A before). Declared as DATA and read back by tooling/ops/check-box-declared.mjs, READ-ONLY over SSH: exit 1 on drift, 2 when it could not look.",
+    "This is the box the product cannot survive losing (tooling/ops/register.json `_substrateHosts._supabaseBoxCronWhy`): every identity's foreign key lives in its database. Its five root crons are the five `duty.supabase-*` rows, carried from Box A byte-identical on 2026-09-24.",
+    "No address is written here; the box is reached through the environment names under `ssh`. A field the public tree does not state is null and is reported UNREAD (LOST) until the first read-back fills it."
+  ],
+  "roles": ["auth"],
+  "provider": { "vendor": "hostinger", "plan": "KVM 8", "product": "VPS" },
+  "cost": { "source": "Private/platform-state/identity.json", "vendorId": "hostinger", "why": "Cited by vendor id, never copied: CI cannot read Private, so box-move grades the cost delta LOST there." },
+  "spec": { "cpu": 8, "ramGiB": 32, "diskGiB": 400, "asOf": "2026-10-01", "verify": "check-box-declared.mjs reads nproc, free -b and df -B1 / and compares (RAM and disk within 15% below the plan's figure)" },
+  "ssh": { "hostEnv": "BOXC_SSH_HOST", "userEnv": "BOXC_SSH_USER", "keyEnv": "BOXC_SSH_KEY", "portEnv": "BOXC_SSH_PORT", "sudoEnv": "BOXC_SSH_SUDO" },
+  "cronTz": { "value": "Asia/Kolkata", "measuredOn": "2026-09-06", "by": "timedatectl", "cite": "tooling/ops/register.json#duty.supabase-dump", "carried": "measured on Box A, whose crontab moved to this box byte-identical on 2026-09-24; the read-back re-reads it here (trap shell-25: cron reads the timezone once at start, so record it as read, never as assumed)" },
