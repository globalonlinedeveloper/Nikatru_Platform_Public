+    { "id": "supabase-db", "image": "supabase/postgres", "version": "17.6.1.136", "compose": { "project": "supabase", "service": "db" }, "containers": 1, "hostnames": [], "secrets": ["POSTGRES_PASSWORD", "JWT_SECRET"], "use": null },
+    { "id": "gotrue", "image": "supabase/gotrue", "version": null, "compose": { "project": "supabase", "service": "auth" }, "containers": 1, "hostnames": ["auth-api.nikatru.com"], "secrets": ["JWT_SECRET", "GOTRUE_SMTP_USER", "GOTRUE_SMTP_PASS", "GOTRUE_EXTERNAL_APPLE_SECRET"], "use": null },
+    { "id": "envoy", "image": "envoyproxy/envoy", "version": null, "compose": { "project": "supabase", "service": null }, "containers": 1, "hostnames": ["auth-api.nikatru.com"], "secrets": [], "use": null },
+    { "id": "studio", "image": "supabase/studio", "version": null, "compose": { "project": "supabase", "service": "studio" }, "containers": 1, "hostnames": ["studio.nikatru.com"], "secrets": ["DASHBOARD_PASSWORD"], "use": null }
+  ],
+  "units": ["docker", "containerd", "cron", "ssh", "cloudflared", "beszel-agent"],
+  "volumes": [
+    { "name": "/opt/supabase", "kind": "bind", "holds": "the compose project, its .env (JWT_SECRET is read from it by the dump) and the dumps (backups/)", "backupSets": ["supabase-auth-pg"] },
+    { "name": "db-config", "kind": "named", "holds": "the pgsodium root key the dump copies out (duty.supabase-dump)", "backupSets": ["supabase-auth-pg"] }
+  ],
