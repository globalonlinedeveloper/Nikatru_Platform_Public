+  });
+
+  it('🔴 a store that ignores the TTL fails `ttl-expires`', async () => {
+    const c = collect();
+    let t = 0;
+    const store = memoryKv({ now: () => t });
+    const ignoresTtl = { ...store, put: (k: string, v: string) => store.put(k, v) };
