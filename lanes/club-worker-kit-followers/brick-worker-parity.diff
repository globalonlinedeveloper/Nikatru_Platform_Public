+      kv.push({ id, title });
+      return { id, title };
+    },
+    r2Buckets: async () => { calls.push('GET r2'); return [...r2]; },
+    createR2: async (name) => { calls.push(`POST r2 ${name}`); r2.push({ name }); return { name }; },
+  };
