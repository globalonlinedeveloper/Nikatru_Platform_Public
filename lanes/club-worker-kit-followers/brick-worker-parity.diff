+
+/** A fake Cloudflare: KV namespaces and R2 buckets in memory, every call recorded. */
+function fakeApi({ kv = [], r2 = [] } = {}) {
+  const calls = [];
+  let n = 0;
+  return {
+    calls,
+    kv,
+    r2,
+    kvNamespaces: async () => { calls.push('GET kv'); return [...kv]; },
+    createKv: async (title) => {
