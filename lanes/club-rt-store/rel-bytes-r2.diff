+/** Every regular file under `dir`, so an empty mapping is refused before it is packed. */
+function filesUnder(dir) {
+  const out = [];
+  const walk = (d) => {
+    for (const e of listDir(d)) {
+      const p = join(d, e);
+      const st = statSync(p);
+      if (st.isDirectory()) walk(p);
+      else if (st.isFile()) out.push(p);
+    }
+  };
+  walk(dir);
+  return out;
+}
