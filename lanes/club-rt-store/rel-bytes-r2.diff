+function coverageLost(why) {
+  console.error(`✗ COVERAGE LOST — ${why}`);
+  process.exitCode = 2;
+  return 2;
+}
+
+function main(argv) {
+  const say = (m) => console.log(m);
+  const deny = (m) => {
+    console.error(`✗ r2-durable-copy: ${m}`);
+    return 1;
+  };
