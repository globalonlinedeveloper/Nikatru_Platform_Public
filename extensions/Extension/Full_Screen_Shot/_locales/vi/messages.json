  "optionsInfiniteScrollDesc": {
    "message": "Dành cho nguồn cấp không có nút \"tải thêm\": cuộn xuống cuối rồi chờ trang tiếp theo, lặp lại cho tới khi nguồn cấp không dài thêm nữa (có giới hạn, nên không đuổi theo những dòng tin bất tận). Phần đã tải vẫn ở lại sau khi chụp xong."
  },
  "optionsWaitStable": {
