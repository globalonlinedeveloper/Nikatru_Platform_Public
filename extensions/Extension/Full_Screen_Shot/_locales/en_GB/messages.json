  "optionsCaptureDelayDesc": {
    "message": "Milliseconds to wait after each scroll. Raise for slow, animation-heavy pages."
  },
  "optionsHideFixed": {
    "message": "Hide fixed & sticky elements"
  },
  "optionsHideFixedDesc": {
    "message": "Keeps headers from repeating on every screen (shown once at top)."
  },
  "optionsPreScroll": {
    "message": "Pre-scroll to load lazy content"
  },
  "optionsPreScrollDesc": {
    "message": "Scrolls through the page once before capturing. Slower but catches lazy-loaded images."
  },
  "optionsAdaptiveWait": {
    "message": "Wait for images to decode"
  },
  "optionsAdaptiveWaitDesc": {
    "message": "Lets late or lazy images finish decoding before each frame, so they aren't captured as black or blank tiles."
  },
  "optionsHideOverlays": {
    "message": "Hide banners & pop-ups"
  },
  "optionsHideOverlaysDesc": {
    "message": "Removes cookie/consent banners, newsletter modals and \"get the app\" pop-ups before capturing, and unlocks pages a modal has frozen. Restored afterward."
  },
  "optionsExpandInner": {
    "message": "Expand scrollable content"
  },
  "optionsExpandInnerDesc": {
    "message": "Grows inner panels and iframes to show content hidden below their own fold, instead of capturing them exactly as seen."
  },
  "optionsExpandPermRow": {
    "message": "Cross-site frames"
  },
  "optionsExpandPermAllow": {
    "message": "Allow"
  },
  "optionsExpandPermGranted": {
    "message": "Permission granted — frames from other sites are expanded too."
  },
  "optionsExpandPermMissing": {
    "message": "Without the \"$PERMISSION$\" permission, cross-site frames are captured as seen. Panels and same-site iframes always work.",
    "placeholders": {
      "permission": {
        "content": "read all websites"
      }
    }
  },
  "optionsUnrollVirtual": {
    "message": "Unroll virtualised lists"
  },
  "optionsUnrollVirtualDesc": {
    "message": "Steps through render-window feeds ($LIB1$ / $LIB2$ style) to capture their full content inline, not just the rows on screen. Slower on very long lists.",
    "placeholders": {
      "lib1": {
        "content": "react-window"
      },
      "lib2": {
        "content": "TanStack"
      }
    }
  },
  "optionsExpandInteractive": {
    "message": "Expand interaction-gated content"
  },
  "optionsExpandInteractiveDesc": {
    "message": "Opens collapsed $DETAILS$, inactive tabs, accordions and \"show more\" sections before capturing, then restores them. Reveals content hidden behind a click.",
    "placeholders": {
      "details": {
        "content": "<details>"
      }
    }
  },
  "optionsLoadMore": {
    "message": "Click \"$BUTTONTEXT$\" buttons",
    "placeholders": {
      "buttontext": {
        "content": "Load more"
      }
    }
  },
  "optionsLoadMoreDesc": {
    "message": "Clicks \"load more\" / \"show more\" buttons and waits for the new content to load, repeatedly, until the feed is exhausted. Unlike the option above, this fetches content that isn't on the page yet; the loaded content stays after capture."
  },
  "optionsInfiniteScroll": {
    "message": "Scroll to load infinite feeds"
  },
  "optionsInfiniteScrollDesc": {
    "message": "For feeds with no \"load more\" button: scrolls to the bottom and waits for the next page to load, repeatedly, until the feed stops growing (bounded, so endless feeds aren't chased). Loaded content stays after capture."
  },
  "optionsWaitStable": {
    "message": "Wait for content to finish loading"
  },
  "optionsWaitStableDesc": {
    "message": "Waits for skeleton / placeholder loaders (aria-busy regions, shimmer blocks) to be replaced by the real content before capturing, so a mid-page \"loading…\" swap isn't captured as grey placeholders. Bounded, so a stuck spinner won't hang the capture."
  },
  "optionsRedactPII": {
    "message": "Auto-redact sensitive info"
  },
  "optionsRedactPIIDesc": {
    "message": "Scans the text a page exposes for emails, phone numbers, credit-card numbers, National Insurance numbers and API keys, and paints a solid block over what it matches in the saved image. It cannot read text drawn as pixels — a canvas, an image, a PDF, a video frame. Detection runs on your device; nothing is ever sent anywhere. Full-page (document-scroll) captures; the block is permanent, so review the result yourself."
  },
  "optionsMaxPageHeight": {
    "message": "Max page height"
  },
  "optionsMaxPageHeightDesc": {
    "message": "Safety cap (CSS px) for infinite-scroll feeds."
  },
