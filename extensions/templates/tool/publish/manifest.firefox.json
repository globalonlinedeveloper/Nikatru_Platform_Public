{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_appName__",
  "short_name": "__MSG_appShortName__",
  "version": "0.0.1",
  "description": "__MSG_appDescription__",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "__MSG_actionDefaultTitle__"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "lib/settings.js",
      "lib/storage.js",
      "lib/jobs.js",
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "skeleton@REPLACE-WITH-YOUR-DOMAIN.example",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
