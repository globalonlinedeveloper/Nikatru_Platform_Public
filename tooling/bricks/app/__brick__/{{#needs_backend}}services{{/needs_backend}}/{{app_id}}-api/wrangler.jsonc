{
  // ───────────────────────────────────────────────────────────────────────────
  // Cloudflare Worker — {{app_id}}-api. Wrangler v4 / jsonc.
  //
  // THIS FILE ONLY EXISTS BECAUSE THE APP WAS STAMPED WITH needs_backend=true.
  // The DEFAULT stamp is client-only: no Worker, no D1 and no R2 of its own —
  // it talks to the ONE shared `platform` Worker for config, analytics,
  // entitlements and account deletion.
  //
  // ── THE CLONE CONTRACT (what may and may not be per-app) ──────────────────
  //   PER-APP   : APP_DB (this D1 only), ALLOWED_ORIGINS, APP_ID
  //   SHARED    : PLATFORM_DB (one entitlements table for the whole portfolio),
  //               JWKS_CACHE, SUPABASE_URL (one identity project),
  //               R2 (ONE portfolio bucket keyed by an `<app_id>/` prefix — a
  //               per-app bucket is never stamped)
  //   NEVER HERE: MoR/payment webhooks. They terminate in `platform`, which
  //               already owns `platform_db.entitlements` keyed by
  //               (user_id, app_id, entitlement). N webhook endpoints would
  //               mean N provider notification destinations and N copies of one
  //               signing secret, for zero benefit.
  //
  // ⚠️ D1 FREE TIER = 10 DATABASES PER ACCOUNT, 5 GB TOTAL (verified against
  //    developers.cloudflare.com/d1/platform/limits, 2026-07-25). platform_db is
  //    one of them, so per-app databases are affordable for at most NINE apps
  //    and the tenth stamp cannot create one at all. That is why a backend is
  //    opt-in: the ceiling gets spent on apps that genuinely store user rows.
  //
  // ── AFTER STAMPING — ONE COMMAND, AND NOTHING IN THIS FILE IS HAND-EDITED ──
  //   node tooling/scripts/provision-backend.mjs {{app_id}}
  // It creates the D1 with `--location apac`, WRITES the returned id into
  // APP_DB.database_id below, and applies the starter migration. The
  // all-zeros placeholder is correct until it runs, and `assert-d1-bindings
  // .mjs` fails any config under services/ that still carries one.
  //
  // 🔴 THIS BLOCK USED TO DIRECT THE READER TO TRANSCRIBE THE NEW UUID INTO THE
  // APP_DB KEY BELOW, BY HAND, and went on saying so for a week after
  // `provision-backend.mjs` had removed the need. [3]S-12's requirement is
  // literally "no hand-editing of placeholders", so the template every backend
  // app is stamped from was directing its owner to perform the exact step the
  // requirement exists to delete — a manual copy of a uuid into one key of a
  // JSONC file, which is the shape of edit that goes wrong silently and deploys
  // a Worker reading the wrong database. No guard reached this file:
  // assert-input-contract.mjs scanned three brick files and this was not one,
  // so the instruction was invisible to CI. It is scanned now — see section 4
  // of that guard, which also explains why this paragraph is worded around the
  // retired phrasing rather than quoting it.
  //
  //   `--location apac` is load-bearing, not cosmetic: location_hint is
  //   CREATE-TIME ONLY and can never be changed afterwards
  //   (company/requirements/architecture.md §18), and D1 places the primary
  //   near WHOEVER ISSUED THE CREATE CALL — so provisioning from a US runner
  //   would silently land an India-served database in North America.
  // Secrets are NOT set here (never committed): set with `wrangler secret put`.
  // ───────────────────────────────────────────────────────────────────────────
  "name": "{{app_id}}-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },
  "vars": {
    "APP_ID": "{{app_id}}",
    "SUPABASE_URL": "https://lcrkiurkvzhkonjwhpiv.supabase.co",
    "API_VERSION": "v1",
    "ALLOWED_ORIGINS": "https://{{{subdomain}}}"
  },
  "d1_databases": [
    {
      // PER-APP. The only resource this Worker owns outright.
      "binding": "APP_DB",
      "database_name": "{{app_id}}_db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    },
    {
      // SHARED across the portfolio. `platform` is the sole migrations applier,
      // so there is deliberately NO migrations_dir here.
      "binding": "PLATFORM_DB",
      "database_name": "platform_db",
      "database_id": "9d1c5c63-97fe-4f82-bc7d-f3fd22e9b351"
    }
  ],
  "kv_namespaces": [
    { "binding": "JWKS_CACHE", "id": "bcfcb1618d1a4bfd8d02f87d3d21010d" }
  ],
  // ───────────────────────────────────────────────────────────────────────────
  // [pipeline B-15] THE STAMPED BACKEND BINDS ITS OWN HOST — NO MANUAL STEP.
  //
  // 🔴 THIS BLOCK WAS MISSING UNTIL 2026-08-03, AND WITHOUT IT A stamped backend
  // deployed to a `*.workers.dev` name and `api-{{app_id}}.nikatru.com` bound to
  // NOTHING. `services/platform/wrangler.jsonc` has always declared its two
  // hosts this way; the template every future app is stamped from declared none,
  // so "answers on its declared API host" was a manual dashboard step nobody
  // wrote down — the exact class of per-app toil the factory exists to remove.
  //
  // `custom_domain: true` auto-provisions the DNS record AND the edge
  // certificate, which is why `platform.nikatru.com` resolves without anyone
  // creating a record. nikatru.com is a zone in this account.
  //
  // ✅ THE WILDCARD DOES NOT BLOCK THIS — MEASURED, NOT ASSUMED. The plan flagged
  // it UNVERIFIED: Cloudflare documents that Custom Domains do not support
  // wildcard DNS records and cannot be created over an existing CNAME, and
  // `*.nikatru.com` has existed since 2026-07-27. Read back from the live account
  // on 2026-08-03 via GET /accounts/:id/workers/domains — THREE Custom Domains
  // exist under that wildcarded zone (config + platform → `platform`,
  // api.nikatru.com → `subly-api`) and the zone's Routes list is EMPTY. So a
  // specific subdomain provisions fine alongside the wildcard.
  //
  // ⚠️ The WEB host `{{app_id}}.nikatru.com` is stage 9/10's and stays out.
  // ───────────────────────────────────────────────────────────────────────────
  "routes": [
    { "pattern": "api-{{app_id}}.nikatru.com", "custom_domain": true }
  ]
  // NO "r2_buckets" HERE ON PURPOSE. Object storage is ONE portfolio-wide
  // bucket bound in `services/platform`, addressed with an `<app_id>/` key
  // prefix. Stamping `{{app_id}}-exports` per app multiplied buckets, lifecycle
  // rules and CORS policies by the number of apps in order to store the same
  // kind of blob under a different name.
}
