  "restorePurchases": "Restore purchases",
  "@restorePurchases": {
    "description": "Re-reads the entitlement from the server. On this rail the entitlement is a server row keyed to the account, so signing in IS the restore — but Apple guideline 3.1.1 makes an explicit control mandatory the day a native IAP rail ships, and its absence is a documented rejection cause."
  },
  "restorePurchasesHint": "Signed in on a new device? This re-checks your subscription.",
  "@restorePurchasesHint": {
