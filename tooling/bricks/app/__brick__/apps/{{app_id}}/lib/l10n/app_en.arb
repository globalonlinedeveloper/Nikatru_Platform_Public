  },
  "cancelFailed": "We could not cancel your subscription. Nothing has changed — please try again.",
  "@cancelFailed": {
    "description": "States plainly that nothing changed. A cancellation that silently did not happen is the worst outcome this screen has, and it must never be reported as success."
  },
