{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tooling/ports/port.schema.json",
  "title": "A port registry: one external capability, the adapters behind it, and how one is selected",
  "description": "The shape of tooling/ports/<capability>.json. Normative text: tooling/ports/README.md. Read by tooling/ci/assert-ports.mjs (limb 1 validates every registry against this file, through the small validator it carries, so this file is the shape and the guard holds no second copy) and by tooling/ops/port-switch.mjs. `_non-port.json` is validated against $defs.nonPortRegister.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "port", "level", "interface", "adapters", "selection", "generated", "handTables", "conformance", "switch", "_why"],
  "properties": {
    "$schema": { "const": "./port.schema.json" },
    "port": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "The capability; equals the file name without .json." },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimed", "target"],
      "properties": {
        "claimed": { "type": "integer", "minimum": 0, "maximum": 3 },
        "target": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "ts": { "$ref": "#/$defs/symbols" },
        "dart": { "$ref": "#/$defs/symbols" }
      }
    },
    "adapters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/adapter" } },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "source", "default", "canary"],
      "properties": {
        "by": { "enum": ["single", "environment", "stream", "channel-market", "per-call"] },
        "source": { "type": ["string", "null"], "pattern": "^[^#\\s]+#[^\\s]+$", "description": "<file>#<pointer> when another register or one code site holds the answer; null when this file's `default` is the whole answer." },
        "default": {
          "type": "object",
          "additionalProperties": false,
          "required": ["live", "sandbox", "test"],
          "properties": {
            "live": { "type": ["string", "null"] },
            "sandbox": { "type": ["string", "null"] },
            "test": { "type": ["string", "null"] }
          }
        },
        "canary": { "type": "null", "description": "Reserved for a percentage cutover; null until a port carries one." }
      }
    },
    "generated": { "type": "boolean", "description": "true once code reads a rendered table instead of a hand array. No port may claim it before the render tool exists." },
    "handTables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "anchor", "until", "why"],
        "properties": {
          "file": { "$ref": "#/$defs/path" },
          "anchor": { "type": "string", "minLength": 4 },
          "until": { "$ref": "#/$defs/train" },
          "why": { "type": "string", "minLength": 20 }
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite", "pending"],
      "properties": {
        "suite": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["file", "runner"],
          "properties": {
            "file": { "$ref": "#/$defs/path" },
            "runner": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
          }
        },
        "pending": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["adapter", "case", "row"],
            "properties": {
              "adapter": { "type": "string" },
              "case": { "type": "string", "minLength": 3 },
              "row": { "type": "string", "pattern": "^O-[A-Z0-9-]+$" }
            }
          }
        }
      }
    },
    "switch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runbook", "dryRun"],
      "properties": {
        "runbook": { "type": ["string", "null"], "pattern": "^Private/runbooks/switch-vendor\\.md#[a-z][a-z0-9-]*$" },
        "dryRun": { "type": "string", "pattern": "^node tooling/ops/port-switch\\.mjs [a-z][a-z0-9-]* --to <adapter> --dry-run$" }
      }
    },
    "_why": { "$ref": "#/$defs/prose" }
  },
  "$defs": {
    "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_.{}@/-]+$" },
    "train": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "prose": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "symbols": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "symbols"],
      "properties": {
        "file": { "$ref": "#/$defs/path" },
        "symbols": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "vendor", "status", "impl", "capabilities", "secrets", "identity", "environments", "cost", "conformance", "exportDuty", "readAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "The wire id: the value the selection names and the code keys on." },
        "vendor": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$", "description": "A tooling/capability-register.json `vendors` key or a tooling/legal/provider-register.json `providers` id; null for a fake." },
        "status": { "enum": ["draft", "built", "live", "standby", "retired", "fake", "external"] },
        "impl": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": { "$ref": "#/$defs/path" },
            "symbol": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "configAt": { "type": "string", "minLength": 4 },
            "verify": { "type": "string", "minLength": 4 }
          }
        },
        "capabilities": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
        "secrets": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "description": "NAMES only." },
        "identity": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$" }, "description": "Field paths into tooling/house-identity.json, never the values." },
        "environments": { "type": "array", "minItems": 1, "items": { "enum": ["test", "sandbox", "live"] } },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["feeCells", "unit"],
          "properties": {
            "feeCells": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "description": "tooling/catalog/fee-register.json `cells` ids, applied by port-switch's margin check." },
            "unit": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["usd", "per", "asOf", "verify"],
              "properties": {
                "usd": { "type": "number", "minimum": 0 },
                "per": { "type": "string", "minLength": 2 },
                "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "verify": { "type": "string", "minLength": 10 }
              }
            }
          }
        },
        "conformance": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["file"],
          "properties": { "file": { "$ref": "#/$defs/path" } }
        },
        "exportDuty": { "type": "string", "minLength": 20 },
        "readAt": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["url", "on"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://" },
            "on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        },
        "c8Seam": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "why", "until"],
          "description": "A DECLARED, PRINTED divergence: this vendor's tooling/capability-register.json seam.file is not this port's interface file. Names the C-8 file exactly, so a C-8 edit re-reddens limb 8.",
          "properties": {
            "file": { "$ref": "#/$defs/path" },
            "why": { "type": "string", "minLength": 20 },
            "until": { "$ref": "#/$defs/train" }
          }
        }
      }
    },
    "nonPortRegister": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "_why", "rows"],
      "properties": {
        "$schema": { "const": "./port.schema.json#/$defs/nonPortRegister" },
        "_why": { "$ref": "#/$defs/prose" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["vendor", "registers", "reason"],
            "properties": {
              "vendor": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "registers": { "type": "array", "minItems": 1, "items": { "enum": ["capability-register", "provider-register"] } },
              "reason": { "type": "string", "minLength": 20 },
              "until": { "$ref": "#/$defs/train" },
              "nonPort": { "const": true, "description": "Deliberately never ported (a platform authority, a store, a retired rail). Exactly one of `until` and `nonPort`." }
            }
          }
        }
      }
    }
  }
}
