{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tooling/ports/port.schema.json",
  "title": "A port registry: one external capability, the adapters behind it, and how one is selected",
  "description": "The shape of tooling/ports/<capability>.json. Normative text: tooling/ports/README.md. Read by tooling/ci/assert-ports.mjs (limb 1 validates every registry against this file, through the small validator it carries, so this file is the shape and the guard holds no second copy) and by tooling/ops/port-switch.mjs. `_non-port.json` is validated against $defs.nonPortRegister.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "port", "level", "interface", "adapters", "selection", "generated", "handTables", "conformance", "switch", "_why"],
  "properties": {
    "$schema": { "const": "./port.schema.json" },
    "port": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "The capability; equals the file name without .json." },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimed", "target"],
      "properties": {
        "claimed": { "type": "integer", "minimum": 0, "maximum": 3 },
        "target": { "type": "integer", "minimum": 0, "maximum": 3 },
        "byInterface": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "A port with BOTH a ts and a dart interface may grade each on its own: the adapters whose impl.file is .ts against the ts interface, the .dart ones against the dart interface. Its keys must be exactly the port's `interface` keys, and the port-level claimed and target are then the LOWEST of them (assert-ports limb 6).",
          "properties": {
            "ts": { "$ref": "#/$defs/levelPair" },
            "dart": { "$ref": "#/$defs/levelPair" }
          }
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "ts": { "$ref": "#/$defs/symbols" },
        "dart": { "$ref": "#/$defs/symbols" },
        "js": { "$ref": "#/$defs/symbols", "description": "A node module (.mjs) in tooling/: the interface of a port whose adapters are operated, not imported by a Worker or an app (boxes)." }
      }
    },
    "adapters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/adapter" } },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "source", "default", "canary"],
      "properties": {
        "by": { "enum": ["single", "environment", "stream", "channel-market", "per-call"] },
        "source": { "type": ["string", "null"], "pattern": "^[^#\\s]+#[^\\s]+$", "description": "<file>#<pointer> when another register or one code site holds the answer; null when this file's `default` is the whole answer." },
        "default": {
          "type": "object",
          "additionalProperties": false,
          "required": ["live", "sandbox", "test"],
          "properties": {
            "live": { "type": ["string", "null"] },
            "sandbox": { "type": ["string", "null"] },
            "test": { "type": ["string", "null"] }
          }
        },
        "canary": { "type": "null", "description": "Reserved for a percentage cutover; null until a port carries one." },
        "byInterface": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "How the adapters of ONE interface are chosen, when that differs from the port-level selection (which then answers for the interfaces not named here). Each key must be a key of `interface`.",
          "properties": {
            "ts": { "$ref": "#/$defs/selectionCore" },
            "dart": { "$ref": "#/$defs/selectionCore" }
          }
        }
      }
    },
    "streams": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/stream" },
      "description": "Optional, for a port selected by `stream` (selection.by: stream): each stream's adapter, its secret NAMES in preference order (the first one set on the Worker wins), and its From as an entity-source PATH. Read by assert-ports limbs 1, 5 and 9 and by port-switch's stream checks."
    },
    "generated": { "type": "boolean", "description": "true once code reads a rendered table instead of a hand array. No port may claim it before the render tool exists." },
    "handTables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "anchor", "until", "why"],
        "properties": {
          "file": { "$ref": "#/$defs/path" },
          "anchor": { "type": "string", "minLength": 4 },
          "until": { "$ref": "#/$defs/train" },
          "why": { "type": "string", "minLength": 20 }
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite", "pending"],
      "properties": {
        "suite": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["file", "runner"],
          "properties": {
            "file": { "$ref": "#/$defs/path" },
            "runner": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
          }
        },
        "pending": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["adapter", "case", "row"],
            "properties": {
              "adapter": { "type": "string" },
              "case": { "type": "string", "minLength": 3 },
              "row": { "type": "string", "pattern": "^O-[A-Z0-9-]+$" }
            }
          }
        }
      }
    },
    "switch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runbook", "dryRun"],
      "properties": {
        "runbook": { "type": ["string", "null"], "pattern": "^(Private)/runbooks/switch-vendor\\.md#[a-z][a-z0-9-]*$" },
        "dryRun": { "type": "string", "pattern": "^node tooling/ops/port-switch\\.mjs [a-z][a-z0-9-]* --to <adapter> --dry-run$" }
      }
    },
    "client": { "$ref": "#/$defs/clientHalf" },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" },
      "description": "Optional. Adapters NOT YET BUILT because an owner step stands in front of them — a store with no developer account. A candidate has no impl and no register row; it records why, the owner steps, and what must be read first. assert-ports limb 8 refuses a candidate whose id already has a tooling/channel-register.json row (it is then an adapter)."
    },
    "_why": { "$ref": "#/$defs/prose" }
  },
  "$defs": {
    "levelPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimed", "target"],
      "properties": {
        "claimed": { "type": "integer", "minimum": 0, "maximum": 3 },
        "target": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "selectionCore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "source", "default", "canary"],
      "properties": {
        "by": { "enum": ["single", "environment", "stream", "channel-market", "per-call"] },
        "source": { "type": ["string", "null"], "pattern": "^[^#\\s]+#[^\\s]+$" },
        "default": {
          "type": "object",
          "additionalProperties": false,
          "required": ["live", "sandbox", "test"],
          "properties": {
            "live": { "type": ["string", "null"] },
            "sandbox": { "type": ["string", "null"] },
            "test": { "type": ["string", "null"] }
          }
        },
        "canary": { "type": "null" }
      }
    },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_.{}@/-]+$" },
    "train": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "prose": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "symbols": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "symbols"],
      "properties": {
        "file": { "$ref": "#/$defs/path" },
        "symbols": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "vendor", "status", "impl", "capabilities", "secrets", "identity", "environments", "cost", "conformance", "exportDuty", "readAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "The wire id: the value the selection names and the code keys on." },
        "vendor": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$", "description": "A tooling/capability-register.json `vendors` key or a tooling/legal/provider-register.json `providers` id; null for a fake." },
        "status": { "enum": ["draft", "built", "live", "standby", "retired", "fake", "external"] },
        "impl": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": { "$ref": "#/$defs/path" },
            "symbol": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "configAt": { "type": "string", "minLength": 4 },
            "verify": { "type": "string", "minLength": 4 }
          }
        },
        "outbound": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "symbol", "modules"],
          "description": "The adapter's RailOutbound half (services/_shared/src/ports/payments.ts). Limb 2 holds `symbol` declared in `file`; limb 4 refuses any module but the composition root importing `file` or any of `modules` (the adapter's further private modules).",
          "properties": {
            "file": { "$ref": "#/$defs/path" },
            "symbol": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "modules": { "type": "array", "items": { "$ref": "#/$defs/path" } }
          }
        },
        "capabilities": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
        "secrets": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "description": "NAMES only." },
        "identity": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$" }, "description": "Field paths into tooling/house-identity.json, never the values." },
        "environments": { "type": "array", "items": { "enum": ["test", "sandbox", "live"] }, "description": "Empty only for a `draft` or `retired` adapter, which no environment may select (assert-ports limb 1)." },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["feeCells", "unit"],
          "properties": {
            "feeCells": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "description": "tooling/catalog/fee-register.json `cells` ids, applied by port-switch's margin check." },
            "unit": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["usd", "per", "asOf", "verify"],
              "properties": {
                "usd": { "type": "number", "minimum": 0 },
                "per": { "type": "string", "minLength": 2 },
                "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "verify": { "type": "string", "minLength": 10 }
              }
            }
          }
        },
        "conformance": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["file"],
          "properties": { "file": { "$ref": "#/$defs/path" } }
        },
        "exportDuty": { "type": "string", "minLength": 20 },
        "readAt": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["url", "on"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://" },
            "on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        },
        "delivery": { "$ref": "#/$defs/mailDelivery" },
        "channel": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "A tooling/channel-register.json `channels[].id`, for a port selected per channel (tooling/ports/channels.json). The store is that row's, so `vendor` stays null: a store is placed once, in _non-port.json, as the billing authority. assert-ports limb 8 resolves it."
        },
        "account": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source"],
          "description": "The kind of store account the channel's submissions bind to — what an entity change has to move. A KIND, never the account's values.",
          "properties": {
            "kind": { "enum": ["individual", "organization", "none", "unrecorded"] },
            "source": { "type": "string", "minLength": 10 }
          }
        },
        "c8Seam": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "why", "until"],
          "description": "A DECLARED, PRINTED divergence: this vendor's tooling/capability-register.json seam.file is not this port's interface file. Names the C-8 file exactly, so a C-8 edit re-reddens limb 8.",
          "properties": {
            "file": { "$ref": "#/$defs/path" },
            "why": { "type": "string", "minLength": 20 },
            "until": { "$ref": "#/$defs/train" }
          }
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "secrets", "from", "why"],
      "properties": {
        "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "An adapter id of this port." },
        "secrets": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "description": "Secret NAMES in preference order; the first one set on the Worker is the stream's key." },
        "from": { "type": ["string", "null"], "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$", "description": "The From as a tooling/house-identity.json field PATH; null when the sender is configured outside this tree (an external adapter)." },
        "to": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$", "description": "A fixed recipient as an entity-source PATH, when the stream has one." },
        "why": { "type": "string", "minLength": 20 }
      }
    },
    "mailDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rail", "dnsNeeded", "domainVerification", "warming", "suppression"],
      "description": "What a mail switch must move besides code (tooling/ports/README.md §5): read by port-switch's mail checks.",
      "properties": {
        "rail": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$", "description": "A tooling/mail-transport.json rails[].id whose authRecords this adapter sends under; null until its records are declared there." },
        "dnsNeeded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "name", "expect"],
            "properties": {
              "kind": { "enum": ["spf", "dkim", "mx", "dmarc"] },
              "name": { "type": "string", "minLength": 4 },
              "expect": { "type": "string", "minLength": 4 }
            }
          },
          "description": "For an adapter with no rail yet: the records to publish before cutover (SPF include, DKIM, return-path MX, DMARC alignment)."
        },
        "domainVerification": { "type": "string", "minLength": 20 },
        "warming": { "type": "string", "minLength": 20 },
        "suppression": {
          "type": "object",
          "additionalProperties": false,
          "required": ["export", "import"],
          "properties": {
            "export": { "type": ["string", "null"], "minLength": 10, "description": "How the suppression list (bounces, complaints, unsubscribes) leaves this adapter; null until Private/runbooks/switch-vendor.md#mail names the method." },
            "import": { "type": ["string", "null"], "minLength": 10, "description": "How it enters this adapter; null until the runbook names the method." }
          }
        }
      }
    },
    "clientHalf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "seams", "adapters", "pending", "_why"],
      "description": "Optional: the CLIENT (Dart) half of a port whose seams live in an app package (payments: PurchaseRail and IapBridge, port-pay-client). Its own level, earned by assert-ports limb 10 the way limb 6 earns the port's: each seam's suite runner declared in its file, every seam with two or more adapters (one may be a fake; never a draft or retired one) whose conformance test CALLS that runner with nothing pending, the port's switch runbook and the dry-run tool. Every class in packages/*/lib that implements a seam is one of `adapters` (derived, so a new rail cannot ship unregistered).",
      "properties": {
        "level": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claimed", "target"],
          "properties": {
            "claimed": { "type": "integer", "minimum": 0, "maximum": 3 },
            "target": { "type": "integer", "minimum": 0, "maximum": 3 }
          }
        },
        "seams": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["interface", "suite"],
            "properties": {
              "interface": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "description": "A symbol of interface.dart." },
              "suite": {
                "type": "object",
                "additionalProperties": false,
                "required": ["file", "runner"],
                "properties": {
                  "file": { "$ref": "#/$defs/path" },
                  "runner": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
                }
              }
            }
          }
        },
        "adapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "seam", "status", "impl", "conformance"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "seam": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "description": "The `seams[].interface` it implements." },
              "status": { "enum": ["draft", "built", "live", "standby", "retired", "fake"] },
              "impl": {
                "type": "object",
                "additionalProperties": false,
                "required": ["file", "symbol"],
                "properties": {
                  "file": { "$ref": "#/$defs/path" },
                  "symbol": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
                }
              },
              "conformance": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "required": ["file"],
                "properties": { "file": { "$ref": "#/$defs/path" } },
                "description": "The adapter package's test that CALLS its seam's runner; null only with `waits`."
              },
              "waits": { "type": "string", "minLength": 20, "description": "Why an adapter with no conformance file waits (printed on every run). Required when `conformance` is null." }
            }
          }
        },
        "pending": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["adapter", "case", "row"],
            "properties": {
              "adapter": { "type": "string" },
              "case": { "type": "string", "minLength": 3 },
              "row": { "type": "string", "pattern": "^O-[A-Z0-9-]+$" }
            }
          }
        },
        "_why": { "$ref": "#/$defs/prose" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "submittable", "deferral", "commission", "exportDuty"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 2 },
        "submittable": { "const": false, "description": "A candidate is never submittable: nothing is built until the account exists." },
        "deferral": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "source", "ownerSteps"],
          "properties": {
            "reason": { "type": "string", "minLength": 20 },
            "source": { "type": "string", "minLength": 4 },
            "ownerSteps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } }
          }
        },
        "commission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cell", "asOf", "verify"],
          "description": "The fee-register.json cell for the store's commission, with the date it was read. Null in both until it is read from the store's own terms: a candidate's margin is UNREAD, never a guess.",
          "properties": {
            "cell": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$" },
            "asOf": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "verify": { "type": "string", "minLength": 20 }
          }
        },
        "exportDuty": { "type": "string", "minLength": 20 }
      }
    },
    "nonPortRegister": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "_why", "rows"],
      "properties": {
        "$schema": { "const": "./port.schema.json#/$defs/nonPortRegister" },
        "_why": { "$ref": "#/$defs/prose" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["vendor", "registers", "reason"],
            "properties": {
              "vendor": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "registers": { "type": "array", "minItems": 1, "items": { "enum": ["capability-register", "provider-register"] } },
              "reason": { "type": "string", "minLength": 20 },
              "until": { "$ref": "#/$defs/train" },
              "nonPort": { "const": true, "description": "Deliberately never ported (a platform authority, a store, a retired rail). Exactly one of `until` and `nonPort`." }
            }
          }
        }
      }
    }
  }
}
