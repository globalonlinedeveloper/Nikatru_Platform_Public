# status.nikatru.com — the public status page (lane status-page). Static bytes on
# their own Pages project, generated by tooling/status/build-status.mjs: no
# script, no cookie, no third-party request, so the policy is `default-src
# 'none'` with only the same-origin stylesheet allowed.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# The page, its data and its feed change with every publish: always revalidate.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/status.json
  Cache-Control: public, max-age=0, must-revalidate
/feed.xml
  Cache-Control: public, max-age=0, must-revalidate
/*.css
  Cache-Control: public, max-age=0, must-revalidate
# No script ships here; the class is declared so one arriving is never left to a default.
/*.js
  Cache-Control: public, max-age=0, must-revalidate
