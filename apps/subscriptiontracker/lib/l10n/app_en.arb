  },
  "paywallHeadline": "Unlock the full experience",
  "@paywallHeadline": {
    "description": "Paywall heading, also used as the in-place PaywallGate title. CHASSIS DEFAULT — a freshly stamped app that has overridden nothing shows this, so it must not promise a feature the chassis does not have."
  },
  "paywallGateMessage": "This part of the app is included with a subscription.",
  "@paywallGateMessage": {
    "description": "Shown in place of a gated surface. States a fact, never a countdown or a discount — the chassis knows neither."
  },
  "paywallUpgrade": "Upgrade",
  "@paywallUpgrade": {
    "description": "The call to action that opens the checkout."
  },
  "paywallOpeningHosted": "Opening the secure checkout in your browser…",
  "@paywallOpeningHosted": {
    "description": "Shown while a HOSTED checkout is being handed to the platform — the rail whose kind is paddle, on the web and the desktop builds. Names the BROWSER deliberately: the page opens outside the app, and a user who is not told that reads the app-switch as a crash. Never shown on a store build: see paywallOpeningStore."
  },
  "paywallOpeningStore": "Connecting to the store…",
  "@paywallOpeningStore": {
    "description": "Shown while a STORE's own purchase sheet is being opened (Play Billing, Apple in-app purchase). 🔴 Names neither the web nor a browser, in any locale: a store build that points its buyer at an outside checkout breaks that store's billing rule. The parity tests fail on either word here."
  },
  "paywallPending": "Your payment is being confirmed. This can take a moment — nothing more is needed from you.",
  "@paywallPending": {
    "description": "🔴 MUST NEVER READ AS A FAILURE. The user may well have paid; the merchant of record's notification simply has not reached our server yet. Saying 'purchase failed' here tells a paying customer their money vanished. WORDING IS A HUMAN DECISION — a green CI lane proves the mechanism, not this sentence."
  },
  "paywallCheckAgain": "Check again",
  "@paywallCheckAgain": {
    "description": "Re-reads the entitlement from the server. Present because the automatic wait is BOUNDED — five attempts over about a minute — and a user whose purchase lands after that needs something to press other than the back button."
  },
  "paywallUnlocked": "You are all set. Thank you.",
  "@paywallUnlocked": {
    "description": "Shown only after the SERVER confirms the entitlement, never on the checkout's return."
  },
  "paywallUnavailable": "Purchases are not available here.",
  "@paywallUnavailable": {
    "description": "Shown when this build cannot sell here: the store it ships through refuses the purchase, the platform cannot take one, or there are no plans to offer. After a refusal, paywallTryAgain sits beneath it. The engineering reason goes to the log and is NEVER rendered: it is English, and it names mechanisms a buyer has no use for. Store builds show this sentence, so it names neither the web nor a browser."
  },
  "paywallRetryMessage": "The purchase could not be started. Please try again.",
  "@paywallRetryMessage": {
    "description": "Shown when a purchase could not be started but may start on a second try: the checkout did not open, the rail was not ready, or the account had not yet reached the store. paywallTryAgain sits beneath it. Store builds show it, so it names neither the web nor a browser."
  },
  "paywallTryAgain": "Try again",
  "@paywallTryAgain": {
    "description": "After a refusal, returns the buyer to the plans so a purchase can be started again."
  },
