<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- ⏱ 2026-10-01 · THE LOCALES THIS APP SHIPS (C-18). One entry per arb in
	     lib/l10n/ — tooling/ci/assert-bundle-locales.mjs derives the set from
	     l10n.yaml and fails when this list and the arbs disagree. Without it the
	     OS lists the app under its development region alone. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ta</string>
		<string>hi</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDisplayName</key>
	<string>Subscriptions</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<!-- ⏱ 2026-09-23 · THE AUTH CALLBACK. gotrue ends sign-up confirmation,
	     OAuth, identity linking and password reset at
	     com.nikatru.subscriptiontracker://auth-callback?nk_auth=<flow>&amp;code=…;
	     Launch Services hands it to this app, where supabase_flutter's
	     app_links listener exchanges the PKCE code. One source for the scheme:
	     authCallbackScheme() in packages/auth_supabase/lib/src/auth_redirect.dart;
	     tooling/ci/assert-auth-callbacks.mjs fails the build if this drifts. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.nikatru.subscriptiontracker</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
