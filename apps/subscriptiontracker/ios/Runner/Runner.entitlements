<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ⏱ 2026-09-15 · [ADR 082] §5. Apple Declared Age Range, read ONLY for the
	     sign-up age gate (packages/platform_storage AgeSignalsPlugin.swift).
	     Without it AgeRangeService.requestAgeRange throws and the gate proceeds on
	     the 18+ declaration. The App ID capability was enabled and the App Store
	     profile regenerated by the owner on 2026-09-15; every key in this file must
	     also be in that profile, and build-platforms.yml's PROVE step fails the
	     lane if the signed .ipa or its embedded.mobileprovision lacks one. -->
	<key>com.apple.developer.declared-age-range</key>
	<true/>
	<!-- ⏱ 2026-10-01 · EN-19. The NATIVE Sign in with Apple sheet
	     (packages/auth_supabase AppleSignInSheet) will not present without it.
	     Derived from APPLE_ID_AUTH in tooling/apple-provisioning.json; the App ID
	     already carries the capability, so the profile already grants it. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
