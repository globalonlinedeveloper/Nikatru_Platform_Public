{
  // ───────────────────────────────────────────────────────────────────────────
  // Cloudflare Worker — platform. Wrangler v4 / jsonc. The ONE shared service:
  //   • GET /config/<app>  — CFG-1 config chassis (KV-backed, edge-cached) with
  //                          compiled-in defaults; DATA/flags, never server UI.
  //   • cron 0 6 * * *     — CONSOLIDATED scheduler for the whole portfolio
  //                          (Supabase keep-alive + per-app renewals fan-out),
  //                          staying under the 5-cron-triggers/account Free cap.
  //
  // Sole applier of platform_db migrations (entitlements). Per-app APP_DBs are
  // bound read/write here ONLY for the renewals fan-out (subly today; add more
  // as apps ship). Secrets via `wrangler secret put` (never committed).
  // ───────────────────────────────────────────────────────────────────────────
  "name": "platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },
  "vars": {
    "APP_ID": "platform",
    "SUPABASE_URL": "https://lcrkiurkvzhkonjwhpiv.supabase.co",
    "API_VERSION": "v1",
    // ⚠️ EXACT allowlist — no pattern matching, and an EMPTY value now DENIES
    // every browser origin rather than falling back to '*'. This Worker is no
    // longer config-read-only: it serves /v1/events and /v1/consent, and will
    // serve entitlements and account deletion ([ADR 020]).
    //
    // EVERY NEW APP'S WEB ORIGIN MUST BE ADDED HERE AND THIS WORKER REDEPLOYED,
    // or that app silently loses config resolution and analytics in the browser.
    // The brick's post_gen checklist prints this as a required step.
    //
    //   subly.nikatru.com  — the live Subly web app
    //   subly-9cp.pages.dev — its Cloudflare Pages preview domain (mirrors the
    //                         same pair in services/subly-api)
    //   localhost:3000      — the local Subly web dev server (.claude/launch.json).
    //                         It fetches config.nikatru.com cross-origin from the
    //                         browser, so omitting it breaks local web dev.
    "ALLOWED_ORIGINS": "https://subly.nikatru.com,https://subly-9cp.pages.dev,http://localhost:3000"
  },
  "d1_databases": [
    {
      // SHARED entitlements DB. platform is the SOLE migrations applier.
      "binding": "PLATFORM_DB",
      "database_name": "platform_db",
      "database_id": "9d1c5c63-97fe-4f82-bc7d-f3fd22e9b351",
      "migrations_dir": "migrations"
    },
    {
      // Subly's per-app DB — bound for the nightly renewals fan-out only.
      // (subly-api owns subly_db's own migrations; NO migrations_dir here.)
      "binding": "SUBLY_DB",
      "database_name": "subly_db",
      "database_id": "88da9026-f72a-4cda-823d-431148fa8112"
    }
  ],
  "kv_namespaces": [
    // Edge-cached per-app config overrides (key: `config:<app>`).
    { "binding": "CONFIG_KV", "id": "33e4e58abb644d0e917a159227c6c134" }
  ],
  "ratelimits": [
    {
      // FAIRNESS bucket for /v1/events + /v1/consent (G-12). NOT a KV counter:
      // KV is eventually consistent with a ~60s edge cache, so under the exact
      // burst a breaker exists to stop, a KV counter reads stale and lets it
      // through. 120 requests/min per (app_id, anon_id) is far above any honest
      // client (the SDK batches 20 events per request), so one noisy install
      // cannot starve the portfolio.
      //
      // ⚠️ THIS KEY IS ENTIRELY CLIENT-CHOSEN, and the route is unauthenticated
      // by design — a caller that rotates `anon_id` gets a fresh bucket per
      // request. The previous claim here ("far below what could burn the
      // free-tier D1 write allowance") was FALSE and is removed: this entry
      // bounds one honest install, nothing more. EVENTS_CEILING_LIMITER below is
      // the half that a caller cannot rotate out of.
      "name": "EVENTS_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      // SERVER-DERIVED ceiling, keyed `edge:<colo>:<asn>` from `request.cf` —
      // no request-body value is in the key, so it cannot be rotated out of.
      // (Not CF-Connecting-IP: that header is never read, and nothing is stored.)
      // Its OWN namespace_id so it does not consume the per-install budget.
      //
      // 600/min per (colo, asn) is ~10 req/s from one network through one PoP —
      // far above a real user population in one ASN batching 20 events per
      // request, and it turns "unbounded" into "bounded". It is a BURST bound,
      // not an accounting system: the binding is per-colo and eventually
      // consistent, so the account-wide daily D1 write budget still needs the
      // separate aggregate guard ([11]E-2 → [4]B-13/B-6).
      "name": "EVENTS_CEILING_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      // The SAME server-derived ceiling for GET /config/<app> — the other
      // unauthenticated route on this Worker that does I/O. Keyed
      // `edge:<colo>:<asn>` by the shared src/lib/edge-ceiling.ts, so there is
      // ONE definition of that key rather than two that drift.
      //
      // Its OWN namespace_id: config traffic and analytics traffic must not be
      // able to exhaust each other's budget. An unknown app is now free (the
      // registry of known apps is compiled in, so that 404 needs no KV read),
      // but a KNOWN app still costs one KV read whenever the edge cache misses —
      // and the query string is part of the cache key, so `?cb=<random>` misses
      // deliberately and unboundedly.
      //
      // 1200/min per (colo, asn) is roughly double the analytics ceiling because
      // this is a cheap read on every app's LAUNCH path served from a 300s edge
      // cache: honest origin traffic through one PoP for one ASN is a handful of
      // requests per cache period, so this is nowhere near real usage while
      // still turning "unbounded" into "bounded". Same honest limit as the other
      // two — per-colo and eventually consistent, a burst bound, not accounting.
      "name": "CONFIG_CEILING_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 1200, "period": 60 }
    }
  ],
  "triggers": {
    // ONE nightly cron for the whole portfolio (06:00 UTC).
    "crons": ["0 6 * * *"]
  },
  "routes": [
    // CFG-1 bootstrap host. Already-released Subly builds have this compiled
    // in, so it is permanent regardless of what else moves.
    { "pattern": "config.nikatru.com", "custom_domain": true },
    // The portfolio API host. A CLIENT-ONLY stamped app (the brick default,
    // needs_backend=false) has no Worker of its own and talks to this for
    // everything shared: analytics, entitlements, account deletion, MoR
    // webhooks. custom_domain auto-provisions the DNS record + edge cert
    // (nikatru.com is a zone in this account).
    { "pattern": "platform.nikatru.com", "custom_domain": true }
  ]

  // NO "r2_buckets" YET — nothing reads or writes object storage today, and an
  // unresolvable bucket binding would fail this Worker's deploy. WHEN one is
  // needed: create ONE portfolio bucket and bind it HERE, addressed with an
  // `<app_id>/` key prefix. Per-app buckets (`<app>-exports`) were removed from
  // the brick on 2026-07-25 — they multiplied buckets, lifecycle rules and CORS
  // policies by the number of apps to store the same kind of blob.
}
