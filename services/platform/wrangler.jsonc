{
  // ───────────────────────────────────────────────────────────────────────────
  // Cloudflare Worker — platform. Wrangler v4 / jsonc. The ONE shared service:
  //   • GET /config/<app>  — CFG-1 config chassis (KV-backed, edge-cached) with
  //                          compiled-in defaults; DATA/flags, never server UI.
  //   • cron 0 6 * * *     — CONSOLIDATED scheduler for the whole portfolio
  //                          (Supabase keep-alive + per-app renewals fan-out).
  //   • cron 0 18 * * *    — the GitHub dispatcher ALONE (see triggers below).
  //
  // ⚠️ "staying under the 5-cron-triggers/account Free cap" STOOD HERE UNTIL
  // 2026-09-03 AND IS NO LONGER TRUE: the account is on Workers Paid, where the
  // ceiling is 250 cron triggers per account, not 5
  // (developers.cloudflare.com/workers/platform/limits). Consolidating was
  // FORCED; it is now a CHOICE, kept because one place to look is worth more
  // than a Worker per job.
  //
  // Sole applier of platform_db migrations (entitlements). Per-app APP_DBs are
  // bound read/write here ONLY for the renewals fan-out (subscriptiontracker today; add more
  // as apps ship). Secrets via `wrangler secret put` (never committed).
  // ───────────────────────────────────────────────────────────────────────────
  "name": "platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },
  "vars": {
    "APP_ID": "platform",
    "SUPABASE_URL": "https://lcrkiurkvzhkonjwhpiv.supabase.co",
    "API_VERSION": "v1",
    // WHICH MONEY WORLD THIS DEPLOY IS — [pipeline 5]M-12. Exactly "live" or
    // "sandbox"; POST /v1/money/:provider answers 503 for anything else, because
    // a default would either honour sandbox money as real or stop honouring real
    // money, and neither is a safe guess.
    //
    // ⚠️ THIS IS THE DEPLOYED CONFIG, SO IT IS "live". A sandbox rail is a
    // SEPARATE wrangler environment with its own secret, never this file with
    // the value edited — tooling/ci/assert-money-config.mjs fails the build on a
    // sandbox value or a sandbox base URL here, and that input is constructible,
    // which is the whole point of the check. That environment is `env.sandbox`
    // at the foot of this file (MONEY_ENVIRONMENT "sandbox", its own database,
    // namespaces and limiters), deployed only by deploy-sandbox.yml.
    "MONEY_ENVIRONMENT": "live",
    // ⚠️ EXACT allowlist — no pattern matching, and an EMPTY value now DENIES
    // every browser origin rather than falling back to '*'. This Worker is no
    // longer config-read-only: it serves /v1/events and /v1/consent, and will
    // serve entitlements and account deletion ([ADR 020]).
    //
    // EVERY NEW APP'S WEB ORIGIN MUST BE ADDED HERE AND THIS WORKER REDEPLOYED,
    // or that app silently loses config resolution and analytics in the browser.
    // The brick's post_gen checklist prints this as a required step.
    //
    //   nikatru.com         — every app's public origin since [ADR 075]
    //   subscriptiontracker-7qg.pages.dev — the app's Cloudflare Pages preview
    //                         domain (mirrored in services/subscriptiontracker-api)
    //   localhost:3000      — the local Subly web dev server (.claude/launch.json).
    //                         It fetches config.nikatru.com cross-origin from the
    //                         browser, so omitting it breaks local web dev.
    //
    // ⚠️ THIS LIST IS DELIBERATELY NOT A MIRROR OF services/subscriptiontracker-api's, AND THE
    // ASYMMETRY IS ONE LINE LONG. A review on 2026-09-08 read the two lists as
    // drift — `http://localhost:3000` here, absent there, beside the "mirrors"
    // note above — so the reason is written HERE, next to the value, rather than
    // only in the middleware two directories away:
    //
    //   · the preview origin the note above claims is mirrored
    //     (subscriptiontracker-7qg.pages.dev) IS mirrored, exactly, in both configs.
    //   · localhost is NOT, because it is not the same question in the two
    //     Workers. services/subscriptiontracker-api/src/middleware/cors.ts:38,57 allows ANY
    //     localhost origin BY REGEX — a recorded per-app trade, because
    //     `flutter drive -d web-server` picks a random port that cannot be named
    //     in advance — so listing one here would assert something that config
    //     does not need to carry. THIS Worker's middleware has no such regex:
    //     `grep -n localhost services/platform/src/middleware/cors.ts` returns
    //     NOTHING (measured 2026-09-08, exit 1), which is why the one port local
    //     web dev actually uses has to be listed explicitly.
    //
    // 🔴 AND THE ASYMMETRY IS ENFORCED, IN BOTH DIRECTIONS, so this paragraph is
    // not the thing holding it up: tooling/ci/assert-cors-allowlist.mjs derives
    // each Worker's required origins from catalog/apps.json and requires the
    // declared set to EQUAL derived ∪ EXTRAS. Adding localhost to subscriptiontracker-api to
    // "re-sync" the two files fails the build as an unjustified origin; removing
    // it from here fails as a missing EXTRA. Do not hand-sync these two lines.
    // NARROWED 2026-09-09, THE LAST STEP OF THE MIGRATION [ADR 075]. This list was
    // WIDENED before the move -- apex added, subdomain held -- because an exact
    // allowlist fails CLOSED and silently, so a browser still holding the app open
    // at subly.nikatru.com would have lost its API the moment this Worker deployed.
    // That window is over: the zone Redirect Rule now 301s every request on that
    // host to https://nikatru.com/subscriptiontracker/ (measured: /, /x, /version.json and a deep
    // path with a query all 301 in one hop to a 200), so no page is served there and
    // no browser sends that Origin any more. The entry justifying it in
    // assert-cors-allowlist.mjs EXTRAS is removed in this same change.
    //
    // THE ORDER WAS THE WHOLE SAFETY PROPERTY: widen, cut over, then narrow.
    // (The original note is kept below, because the reason it was widened is the
    // reason it could be narrowed.)
    // WIDENED BEFORE THE MOVE, NOT AFTER IT [ADR 075]. The apex comes FIRST
    // because it is now the app's public origin (nikatru.com/<id>); the
    // subdomain stays for the length of the cutover ONLY, so that the copy of
    // the app still being served at subly.nikatru.com does not lose its API the
    // moment this Worker deploys. An exact allowlist fails CLOSED and silently,
    // so the order of operations is the whole safety property: widen, cut over,
    // then narrow. The subdomain's line out of here is the LAST step of the
    // migration, and it is justified in assert-cors-allowlist.mjs EXTRAS until
    // then -- not left unexplained.
    // WIDENED AGAIN 2026-09-09, FOR THE PAGES-PROJECT MOVE THIS TIME, and the
    // order is the same safety property as above: widen, cut over, then narrow.
    // deploy-web.yml deploys with `--project-name=${{ matrix.app }}` and the
    // matrix is the DIRECTORY name, so renaming `apps/subly` moves this app's
    // Direct Upload project to `subscriptiontracker`. Its *.pages.dev subdomain
    // was READ BACK from the create call rather than guessed --
    // `subscriptiontracker-7qg.pages.dev` -- because the bare name is taken by a
    // THIRD PARTY (subscriptiontracker.pages.dev answers 200 and is not ours).
    // Both preview origins were held for the length of the cutover; the old one
    // left in its own later change.
    // NARROWED 2026-09-11: `subly-9cp.pages.dev` left this list, the api Worker's,
    // and the guard's EXTRAS together. It still resolved and served only the
    // RETIRED Subly build, and a *.pages.dev name is claimable by anyone once its
    // project is deleted -- so the grant leaves first, both Workers deploy, and
    // only then may the owner delete the Pages project.
    "ALLOWED_ORIGINS": "https://nikatru.com,https://subscriptiontracker-7qg.pages.dev,http://localhost:3000",
    // WHERE EACH APP'S OWN ERASURE ROUTE LIVES — `<appId>=<https origin>`.
    //
    // 🔴 DELETE /v1/account IS THE PORTFOLIO'S ERASURE ENTRY POINT AND THIS
    // WORKER CAN ONLY EMPTY platform_db. A route reads the databases it reads,
    // not the ones its Worker happens to bind — so before this list existed, a
    // Subly user could delete their account and leave every subscription, budget
    // and payment they had entered in the app database, behind a login that no longer
    // existed. The shared route now relays the caller's own bearer token to each
    // app's own DELETE /v1/account (services/subscriptiontracker-api/src/routes/account.ts),
    // AFTER the service-role precondition and BEFORE the identity is deleted.
    //
    // ⚠️ EVERY NEW APP WITH ITS OWN DATABASE MUST BE ADDED HERE. Binding an app's
    // D1 to this Worker without an entry fails the build
    // (tooling/ci/assert-erasure-reach.mjs) rather than silently orphaning that
    // app's rows on every deletion. `https://` is required: the relay forwards a
    // live session token.
    "APP_ERASURE_ENDPOINTS": "subscriptiontracker=https://subscriptiontracker-api.nikatru.com"
  },
  // ── ⏱ 2026-09-15 · THE ERASURE RETRY, OVER A SERVICE BINDING ([ADR 081]) ──
  //
  // When DELETE /v1/account cannot reach an app it records a pending erasure and
  // answers 202; the nightly cron (src/scheduled.ts) retries by calling the app's
  // `ErasureEntrypoint` through the binding below. A Service Binding is declared
  // HERE, in the calling Worker's own config, and is callable only by this Worker
  // inside the account: no public route, no bearer token, no shared secret. Proven
  // on this account with two throwaway Workers on 2026-09-15 (both deleted).
  //
  // ⚠️ ONE BINDING PER APP IN APP_ERASURE_ENDPOINTS, named `ERASURE_<APP_ID>` in
  // upper case (src/lib/erasure-ledger.ts `erasureBindingName`), entrypoint
  // `ErasureEntrypoint`. tooling/ci/assert-erasure-reach.mjs refuses an app in the
  // list above with no matching binding: without it an unreachable app is a 502
  // again, because an order nobody can retry is not recorded.
  "services": [
    {
      "binding": "ERASURE_SUBSCRIPTIONTRACKER",
      "service": "subscriptiontracker-api",
      "entrypoint": "ErasureEntrypoint"
    }
  ],
  "d1_databases": [
    {
      // SHARED entitlements DB. platform is the SOLE migrations applier.
      "binding": "PLATFORM_DB",
      "database_name": "platform_db",
      "database_id": "9d1c5c63-97fe-4f82-bc7d-f3fd22e9b351",
      "migrations_dir": "migrations"
    },
    {
      // The app's per-app DB — bound for the nightly renewals fan-out only.
      // (subscriptiontracker-api owns subscriptiontracker_db's migrations; NO migrations_dir here.)
      "binding": "SUBSCRIPTIONTRACKER_DB",
      "database_name": "subscriptiontracker_db",
      "database_id": "0a36d6a0-c909-40aa-853e-970de3482321"
    }
  ],
  "kv_namespaces": [
    // Edge-cached per-app config overrides (key: `config:<app>`).
    { "binding": "CONFIG_KV", "id": "33e4e58abb644d0e917a159227c6c134" },
    // Warm cache for the Supabase JWKS document, so an ES256 verify on
    // DELETE /v1/account does not fetch it on every cold isolate. The SAME
    // namespace services/subscriptiontracker-api binds: there is one identity project for the
    // whole portfolio, so a second namespace would be a second copy of one
    // public document, doubling the KV writes that cache costs against a Free
    // budget of 1,000/day account-wide (tooling/ceilings.json → kv.writesPerDay).
    { "binding": "JWKS_CACHE", "id": "bcfcb1618d1a4bfd8d02f87d3d21010d" },
    // BOUND FOR THE NIGHTLY EXPORT AND NOTHING ELSE. `06 §3.4` measured this
    // namespace bound to NO Worker — 2 list operations, 0 reads, 0 writes in
    // seven days — so it was a store that could disappear with nobody noticing.
    // src/backup/ cannot back up what the Worker cannot read; no route touches it.
    { "binding": "SIGNUPS", "id": "d73cf5ffd0fd4d8396012fccd15906ad" }
  ],
  // ── THE ONE PORTFOLIO BACKUP BUCKET ────────────────────────────────────────
  //
  // 🔴 THE COMMENT AT THE FOOT OF THIS FILE SAID "NO r2_buckets YET — nothing
  // reads or writes object storage today". That stopped being true on 2026-09-05:
  // `06 §4.2` measured D1 and KV in NO backup at all, with `platform_db` — the
  // entitlements store, the busiest datastore in the estate — holding who has
  // paid for what behind no export, no snapshot and a recovery path recorded as
  // NEVER drilled. src/backup/ writes here nightly at 02:30 UTC.
  //
  // ⚠️ ONE bucket for the portfolio, addressed by key prefix (`d1/`, `kv/`,
  // `manifests/`) — the same rule the removed per-app `<app>-exports` buckets
  // broke. A second backup bucket is a second lifecycle policy to forget.
  "r2_buckets": [
    { "binding": "BACKUPS_R2", "bucket_name": "nikatru-backups" }
  ],
  "ratelimits": [
    {
      // FAIRNESS bucket for /v1/events + /v1/consent (G-12). NOT a KV counter:
      // KV is eventually consistent with a ~60s edge cache, so under the exact
      // burst a breaker exists to stop, a KV counter reads stale and lets it
      // through. 120 requests/min per (app_id, anon_id) is far above any honest
      // client (the SDK batches 20 events per request), so one noisy install
      // cannot starve the portfolio.
      //
      // ⚠️ THIS KEY IS ENTIRELY CLIENT-CHOSEN, and the route is unauthenticated
      // by design — a caller that rotates `anon_id` gets a fresh bucket per
      // request. The previous claim here ("far below what could burn the
      // free-tier D1 write allowance") was FALSE and is removed: this entry
      // bounds one honest install, nothing more. EVENTS_CEILING_LIMITER below is
      // the half that a caller cannot rotate out of.
      "name": "EVENTS_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      // SERVER-DERIVED ceiling, keyed `edge:<colo>:<asn>` from `request.cf` —
      // no request-body value is in the key, so it cannot be rotated out of.
      // (Not CF-Connecting-IP: that header is never read, and nothing is stored.)
      // Its OWN namespace_id so it does not consume the per-install budget.
      //
      // 600/min per (colo, asn) is ~10 req/s from one network through one PoP —
      // far above a real user population in one ASN batching 20 events per
      // request, and it turns "unbounded" into "bounded". It is a BURST bound,
      // not an accounting system: the binding is per-colo and eventually
      // consistent, so the account-wide daily D1 write budget still needs the
      // separate aggregate guard ([11]E-2 → [4]B-13/B-6).
      "name": "EVENTS_CEILING_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      // The SAME server-derived ceiling for GET /config/<app> — the other
      // unauthenticated route on this Worker that does I/O. Keyed
      // `edge:<colo>:<asn>` by the shared src/lib/edge-ceiling.ts, so there is
      // ONE definition of that key rather than two that drift.
      //
      // Its OWN namespace_id: config traffic and analytics traffic must not be
      // able to exhaust each other's budget. An unknown app is now free (the
      // registry of known apps is compiled in, so that 404 needs no KV read),
      // but a KNOWN app still costs one KV read whenever the edge cache misses —
      // and the query string is part of the cache key, so `?cb=<random>` misses
      // deliberately and unboundedly.
      //
      // 1200/min per (colo, asn) is roughly double the analytics ceiling because
      // this is a cheap read on every app's LAUNCH path served from a 300s edge
      // cache: honest origin traffic through one PoP for one ASN is a handful of
      // requests per cache period, so this is nowhere near real usage while
      // still turning "unbounded" into "bounded". Same honest limit as the other
      // two — per-colo and eventually consistent, a burst bound, not accounting.
      "name": "CONFIG_CEILING_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 1200, "period": 60 }
    },
    {
      // The SAME server-derived ceiling for POST /v1/money/:provider, keyed
      // `edge:<colo>:<asn>` by the shared src/lib/edge-ceiling.ts.
      //
      // Its OWN namespace_id so a flood of forged notifications cannot exhaust
      // the budget analytics ingest and config resolution depend on — and those
      // two are on every app's launch path, so borrowing from them would let
      // anyone who finds this URL degrade every app in the portfolio.
      //
      // 120/min per (colo, asn) is deliberately the tightest of the three. A
      // merchant of record delivers ONE notification per money event and retries
      // with exponential backoff (Paddle: 60 attempts over 3 days, first 20 in
      // the first hour, 60s base × 1.1 — verified against developer.paddle.com
      // 2026-08-01). Real traffic through one PoP is a handful per minute at the
      // portfolio's eventual scale, so this is orders of magnitude above honest
      // use while still bounding a forged flood. Same honest caveat as the other
      // two: per-colo and eventually consistent, a BURST bound, not accounting.
      "name": "MONEY_CEILING_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      // ⏱ 2026-09-24 · O-EXTENSION-ACCOUNT-CHECK-UNBUILT. The SAME server-derived
      // ceiling for POST /v1/ext/token — the browser extension's code exchange,
      // unauthenticated in the Supabase sense because the one-time code IS the
      // credential. Keyed `edge:<colo>:<asn>` by src/lib/edge-ceiling.ts, NEVER on
      // an IP: this Worker reads no CF-Connecting-IP anywhere.
      //
      // Its OWN namespace_id so a code-guessing flood cannot spend the budget of
      // analytics ingest, config resolution or the money rail.
      //
      // 60/min per (colo, asn): one exchange per sign-in, so 60 a minute leaves
      // room for a shared NAT while still ending a flood against a 128-bit code.
      // `period` is 60, one of tooling/ceilings.json's allowed values. Same
      // honest caveat as the others: per-colo and eventually consistent, a BURST
      // bound, not accounting.
      "name": "EXT_TOKEN_CEILING_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "triggers": {
    // ONE nightly cron for the whole portfolio (06:00 UTC).
    "crons": [
      // 🔴 FOUR FIRINGS, SIX HOURS APART, AND ONLY ONE OF THEM IS THE NIGHTLY
      // HANDLER. `0 6 * * *` runs everything; the other three run the GitHub
      // dispatcher alone (src/scheduled.ts branches on `event.cron`), so
      // `retentionSweep` — the one limb that DESTROYS anything — still fires
      // once a day.
      //
      // ⚠️ WHY FOUR EXPRESSIONS RATHER THAN ONE. The reader that judges these
      // (tooling/ops/check-heartbeats.mjs) accepts a deliberately narrow grammar:
      // a literal minute AND hour, daily or weekly, and — since 2026-09-24 —
      // exactly `<minute> * * * *`, hourly. A step or a list (`0 */6 * * *`,
      // `0 0,6,12,18 * * *`) is still REFUSED, so a six-hourly grid is four
      // literal expressions. With the backup and the hourly stuck-run firing
      // below, this file holds 6 of the 250 cron triggers Workers Paid allows
      // (it was 5 on Free, which is why this file used to say "ONE cron").
      //
      // The margin this buys, measured: the schedule it replaces (ops-watch's
      // own 12 slots) delivered 2.3 successful runs/day with a MAX GAP of 48.8h
      // against a 36h freshness window — six breaches in one month. A 6h cadence
      // leaves 30h of margin on that window.
      "0 0 * * *",
      // 🔴 THE OFF-VENDOR EXPORT, AND THE ONLY CRON HERE THAT IS NEITHER THE
      // NIGHTLY HANDLER NOR A DISPATCHER MARGIN FIRING. src/backup/ writes D1 +
      // KV into R2 (`06 §4.2`). 02:30 is DERIVED, not chosen: Box B dumps at
      // 02:00 and syncs to Drive at 02:30 (`06 §2.5`), so an object written now
      // rides the existing chain within the hour instead of waiting ~20h for the
      // next sync — and it lands BEFORE `retentionSweep` deletes at 06:00, so the
      // archive holds the night the sweep is about to prune.
      "30 2 * * *",
      "0 6 * * *",
      "0 12 * * *",
      "0 18 * * *",
      // 🔴 THE STUCK-RUN CHECK'S OWN HOURLY FIRING (O-OPS-WATCHDOG-STUCK-RUNS-HOURLY,
      // 2026-09-24). src/scheduled.ts routes `OPS_HOURLY_CRON` to `opsStuckRunsJob`
      // alone: no dispatch, no nightly limb, no cron beat. Its own GlitchTip beat
      // (OPS_STUCK_RUNS_HEARTBEAT_URL) goes out only while no Actions run is stuck.
      // :15 keeps it off the :00 grid and the 02:30 backup.
      "15 * * * *"
    ]
  },
  "routes": [
    // CFG-1 bootstrap host. Already-released Subly builds have this compiled
    // in, so it is permanent regardless of what else moves.
    { "pattern": "config.nikatru.com", "custom_domain": true },
    // The portfolio API host. A CLIENT-ONLY stamped app (the brick default,
    // needs_backend=false) has no Worker of its own and talks to this for
    // everything shared: analytics, entitlements, account deletion, MoR
    // webhooks. custom_domain auto-provisions the DNS record + edge cert
    // (nikatru.com is a zone in this account).
    { "pattern": "platform.nikatru.com", "custom_domain": true }
  ],

  // "r2_buckets" NOW EXISTS — see the block above `triggers`. This comment said
  // "NO r2_buckets YET — nothing reads or writes object storage today" until
  // 2026-09-05; the rule it carried SURVIVES and is the reason there is exactly
  // one bucket: ONE portfolio bucket, addressed by key prefix. Per-app buckets
  // (`<app>-exports`) were removed from the brick on 2026-07-25 — they multiplied
  // buckets, lifecycle rules and CORS policies by the number of apps to store the
  // same kind of blob. The other half of the old note still holds: an
  // unresolvable bucket binding FAILS this Worker's deploy, so `nikatru-backups`
  // was created before this line was written (2026-09-05, `wrangler r2 bucket
  // create`), never the other way round.

  // ───────────────────────────────────────────────────────────────────────────
  // 🧪 env.sandbox — THE SANDBOX PLATFORM WORKER (Q11, row
  // O-STORE-CAPTURE-WRITES-UNATTRIBUTED-ROWS; the sandbox money rail of
  // [5]M-12). `wrangler deploy --env sandbox` deploys the script
  // `platform-sandbox`, which answers on
  // https://platform-sandbox.nikatru.workers.dev and nowhere else. A store
  // capture's events, consent and config reads go here instead of production,
  // and a sandbox payment notification is recorded in a sandbox database.
  // Deployed only by .github/workflows/deploy-sandbox.yml (workflow_dispatch);
  // deploy-workers deploys the top level above and never this block.
  //
  // 🔴 EVERY KEY IS DECLARED; NONE IS LEFT TO INHERITANCE. Wrangler inherits
  // `routes`, `workers_dev` and `triggers` into an environment and does NOT
  // inherit `vars`, `d1_databases`, `kv_namespaces`, `r2_buckets` or
  // `services`. Without `routes: []` this block would claim the two production
  // custom domains above for the sandbox script; without `crons: []` it would
  // run the five production crons — the destructive nightly retention sweep
  // among them — a second time. tooling/ci/assert-money-config.mjs limb 1c
  // refuses both, an inherited `workers_dev`, and a production database.
  //
  // ⚠️ `ratelimits` ARE DECLARED WITH THEIR OWN namespace_ids (1006-1010), never
  // the top level's 1001-1005: a shared namespace would let a public sandbox URL
  // spend the budget production's callers are counted against. Every limiter
  // binding is optional and fails OPEN (src/types.ts:63), so an absent one is a
  // sandbox with no breaker at all, not an error anyone would see.
  //
  // NOT BOUND, each on purpose: JWKS_CACHE (optional, src/types.ts:30);
  // SIGNUPS and BACKUPS_R2 (optional, :46 and :54; only the nightly backup
  // cron reads them, src/backup/index.ts); SUBSCRIPTIONTRACKER_DB and the ERASURE_* services
  // (the nightly fan-out and account deletion — no cron runs here, and a
  // sandbox erasure relay into production's app Worker is the one direction
  // this block must not open); APP_ERASURE_ENDPOINTS for the same reason. No
  // secret is set here or anywhere in this file.
  "env": {
    "sandbox": {
      "routes": [],
      "workers_dev": true,
      "triggers": { "crons": [] },
      "vars": {
        // why: src/types.ts:104 — every route and log line names the app by it.
        "APP_ID": "platform",
        // why: the SAME identity project as production (D1 identity option
        // (a)). ES256 verification reads its JWKS, and /v1/health probes it
        // (src/index.ts:143).
        "SUPABASE_URL": "https://lcrkiurkvzhkonjwhpiv.supabase.co",
        // why: src/types.ts:348.
        "API_VERSION": "v1",
        // why: src/middleware/cors.ts:22, copied from the top level. Web stays
        // exactly as production's.
        "ALLOWED_ORIGINS": "https://nikatru.com,https://subscriptiontracker-7qg.pages.dev,http://localhost:3000",
        // why: src/routes/money.ts:97 — THIS is the sandbox money world. The
        // top level's value stays "live" (limb 1), and this one must be
        // exactly "sandbox" (limb 1b).
        "MONEY_ENVIRONMENT": "sandbox"
      },
      "d1_databases": [
        {
          // why: src/types.ts:13 and the /v1/health probe (src/index.ts:127).
          // `platform_db_sandbox`, created 2026-09-23 and EMPTY. This Worker is
          // its sole migration applier, as at the top level.
          "binding": "PLATFORM_DB",
          "database_name": "platform_db_sandbox",
          "database_id": "ead92001-03e1-4f71-9b92-c64963a24925",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        // why: REQUIRED — src/types.ts:18; src/routes/config.ts:52 reads it
        // unguarded and /v1/health probes it (src/index.ts:138), so an absent
        // binding 500s config and reports the Worker unhealthy.
        // `platform-config-sandbox`, created 2026-09-24.
        { "binding": "CONFIG_KV", "id": "7ba3a916f8a5429091dec4a39284bffb" }
      ],
      "ratelimits": [
        {
          // why: src/routes/money.ts:93 and src/routes/receipts.ts:260. The
          // top level's MONEY_CEILING_LIMITER (1004), same limit.
          "name": "MONEY_CEILING_LIMITER",
          "namespace_id": "1006",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          // why: src/routes/events.ts:250 and :356, src/routes/report.ts:126.
          // The top level's EVENTS_LIMITER (1001), same limit.
          "name": "EVENTS_LIMITER",
          "namespace_id": "1007",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          // why: src/routes/events.ts:194 and :324. The top level's
          // EVENTS_CEILING_LIMITER (1002), same limit.
          "name": "EVENTS_CEILING_LIMITER",
          "namespace_id": "1008",
          "simple": { "limit": 600, "period": 60 }
        },
        {
          // why: src/routes/config.ts:48. The top level's
          // CONFIG_CEILING_LIMITER (1003), same limit.
          "name": "CONFIG_CEILING_LIMITER",
          "namespace_id": "1009",
          "simple": { "limit": 1200, "period": 60 }
        },
        {
          // why: src/routes/ext.ts (POST /v1/ext/token). The top level's
          // EXT_TOKEN_CEILING_LIMITER (1005), same limit.
          "name": "EXT_TOKEN_CEILING_LIMITER",
          "namespace_id": "1010",
          "simple": { "limit": 60, "period": 60 }
        }
      ]
    }
  }
}
