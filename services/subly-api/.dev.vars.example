# Copy this file to `.dev.vars` (gitignored) for local `wrangler dev`.
# NEVER commit `.dev.vars` or real secret values. Placeholders only below.
#
# In production these are set with `wrangler secret put <NAME>` instead.

# Optional: legacy HS256 Supabase JWT signing secret. Leave blank to rely on
# asymmetric (JWKS) verification only.
SUPABASE_JWT_SECRET=

# Shared secret used to authenticate the RevenueCat webhook. If blank, the
# webhook FAILS CLOSED: every request answers 503 until the secret is set.
REVENUECAT_WEBHOOK_SECRET=

# [5]M-12 — which money world this local run is. Production wrangler.jsonc says
# 'live'; local development against test receipts should say 'sandbox' so a
# sandbox RevenueCat event is written (and read back) as sandbox money. Blank or
# unrecognised ⇒ the webhook and /v1/entitlements answer 503 (fail closed).
MONEY_ENVIRONMENT=sandbox
