{
  // ───────────────────────────────────────────────────────────────────────────
  // Cloudflare Worker — subscriptiontracker-api. Wrangler v4 / jsonc (migrated from v3 toml).
  // CLONE CONTRACT: APP_DB is PER-APP; PLATFORM_DB + JWKS_CACHE +
  // SESSION_REVOKED + SUPABASE_URL are SHARED across every NIKATRU app (one entitlements table,
  // one identity project). Matches tooling/bricks/app __brick__ services template.
  //
  // Migrations: APP_DB only (services/subscriptiontracker-api/migrations = subscriptiontracker_db). The
  // shared platform_db (entitlements) is owned + migrated by services/platform.
  // Cron: the nightly scheduler is CONSOLIDATED into services/platform (Supabase
  // keep-alive + per-app renewals fan-out) — subscriptiontracker-api no longer carries a cron.
  //
  // Secrets are NOT set here (never committed): set with `wrangler secret put`.
  //   wrangler secret put SUPABASE_JWT_SECRET       # optional HS256 legacy fallback
  // (REVENUECAT_WEBHOOK_SECRET is no longer read here: the legacy RevenueCat route
  // was retired 2026-09-16 in favour of services/platform's /v1/money/revenuecat.)
  // ───────────────────────────────────────────────────────────────────────────
  // ✅ THE DEPLOYED NAME MOVED WITH THE SLUG ON 2026-09-11 ([ADR 079]).
  // Until then this file deployed as `subly-api` and recorded the rename as
  // owed "as its own sequenced change": `wrangler deploy` addresses a Worker BY
  // NAME, so a new name is a NEW WORKER, and a custom domain is attached to
  // exactly one Worker at a time. It was done in that order, with the account
  // read back at each step: `subscriptiontracker.api.nikatru.com` was attached
  // to the running `subly-api` and served /v1/health 200 BEFORE this line
  // changed; the first deploy under this name claims BOTH custom domains in
  // `routes` (wrangler 4.129.0 answers its "Custom Domains already exist ...
  // Update them to point to this script instead?" prompt with its
  // non-interactive fallback, which is `yes`); and `subly-api` is deleted only
  // after this Worker is verified on both hosts.
  "name": "subscriptiontracker-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },
  "vars": {
    "APP_ID": "subscriptiontracker",
    // Shared Supabase identity project (Cross_Platform_Auth, ap-south-1).
    "SUPABASE_URL": "https://lcrkiurkvzhkonjwhpiv.supabase.co",
    "API_VERSION": "v1",
    // This app's web origins only (comma-separated). Empty/absent ⇒ '*'.
    // NARROWED 2026-09-09 -- the subdomain now 301s and serves no page, so nothing
    // sends that Origin. See the longer note in services/platform/wrangler.jsonc.
    // WIDENED BEFORE THE MOVE [ADR 075] -- see the longer note in
    // services/platform/wrangler.jsonc. Apex first; the subdomain is held only
    // until the 301 lands, then removed.
    // WIDENED AGAIN 2026-09-09 FOR THE PAGES-PROJECT MOVE, AND BOTH PREVIEW
    // ORIGINS ARE HELD ON PURPOSE. The slug rename re-points deploy-web at a new
    // Direct Upload project (`subscriptiontracker`, subdomain read back from the
    // API as `subscriptiontracker-7qg.pages.dev`), so for the length of the
    // cutover there are two preview origins that can serve this app: the one the
    // old project still holds and the one the new project starts holding. An
    // exact allowlist fails CLOSED and silently, so the old one is dropped in a
    // SEPARATE, LATER change -- widen, cut over, then narrow, the same order the
    // subdomain removal used. See services/platform/wrangler.jsonc.
    // NARROWED 2026-09-11: `subly-9cp.pages.dev` (the old project's origin) left
    // this list, services/platform's, and the guard's EXTRAS together. It still
    // served only the RETIRED Subly build, and a *.pages.dev name is claimable by
    // anyone once its project is deleted -- so the grant leaves first, the Workers
    // deploy, and only then may the project be deleted.
    "ALLOWED_ORIGINS": "https://nikatru.com,https://subscriptiontracker-7qg.pages.dev",
    // [5]M-12 — this deploy's money world. The RevenueCat webhook ignores
    // events from the other world and /v1/entitlements grants nothing from it.
    // Absent/unrecognised ⇒ 503 on both (fail closed, src/lib/money.ts).
    // Mirrors services/platform/wrangler.jsonc.
    "MONEY_ENVIRONMENT": "live"
  },
  "d1_databases": [
    {
      // Per-app SQLite database (this app's private data). One per app.
      "binding": "APP_DB",
      "database_name": "subscriptiontracker_db",
      "database_id": "0a36d6a0-c909-40aa-853e-970de3482321",
      "migrations_dir": "migrations"
    },
    {
      // SHARED platform database (entitlements across the whole portfolio).
      // Same id in every app's config. Migrated by services/platform (sole
      // applier) — NO migrations_dir here.
      "binding": "PLATFORM_DB",
      "database_name": "platform_db",
      "database_id": "9d1c5c63-97fe-4f82-bc7d-f3fd22e9b351"
    }
  ],
  "kv_namespaces": [
    // Caches the Supabase JWKS document (cuts JWT-verify latency). Shared.
    { "binding": "JWKS_CACHE", "id": "bcfcb1618d1a4bfd8d02f87d3d21010d" },
    // The revocation list (`rev:<sub>`), READ ONLY here by
    // src/middleware/auth.ts; services/platform writes it. Shared.
    { "binding": "SESSION_REVOKED", "id": "aa46ad5002874231931cc5dc5b6e2904" }
  ],

  // ───────────────────────────────────────────────────────────────────────────
  // [pipeline B-15] THE ROUTE THIS WORKER HAS ANSWERED ON SINCE LAUNCH, FINALLY
  // WRITTEN DOWN.
  //
  // 🔴 `api.nikatru.com` WAS BOUND ONLY IN THE DASHBOARD. It served live traffic
  // while this file said nothing about it, so the deployable config and the
  // deployed reality disagreed and no guard could see the gap — the same shape
  // as the `EXPORTS` bucket that was live for two weeks with every check green.
  // A hostname that exists only in a dashboard cannot be reviewed in a diff, is
  // not reproducible from the repo, and disappears silently if anyone clicks the
  // wrong thing.
  //
  // ✅ DECLARING IT IS IDEMPOTENT, AND THAT WAS VERIFIED BEFORE WRITING IT rather
  // than assumed. Read back from the live account 2026-08-03 via
  // GET /accounts/:id/workers/domains: `api.nikatru.com` is already a CUSTOM
  // DOMAIN attached to `subly-api` (the name the account returned on that date, and
  // the name this Worker deployed under until [ADR 079] — see the block at `name` above), and
  // GET /zones/:id/workers/routes for
  // nikatru.com returns an EMPTY list. So this declares exactly what is already
  // there. Had it been a pattern-based Route instead, `custom_domain: true`
  // would have fought the existing binding on the next deploy — which is why the
  // check came first.
  // ───────────────────────────────────────────────────────────────────────────
  "routes": [
    // [ADR 079] an app's API is `<id>.api.nikatru.com`. Its certificate is the
    // free advanced pack a Worker custom domain creates, and the custom domain
    // writes its own DNS record: the `*.nikatru.com` wildcard does not resolve a
    // two-label name and does not need to.
    // [ADR 080] every NIKATRU hostname is ONE label deep: an app's API is
    // `<app>-api.nikatru.com`, covered by the zone's Universal certificate
    // (`nikatru.com, *.nikatru.com`), so it needs no advanced pack and no paid add-on.
    // Attached to the running Worker by API at 15:16Z 2026-09-11 and read back
    // (custom domain c9f93bd1…, /v1/health 200, SAN `nikatru.com, *.nikatru.com`)
    // BEFORE this line merged, so this deploy declares what is already there.
    { "pattern": "subscriptiontracker-api.nikatru.com", "custom_domain": true }
    // `subscriptiontracker.api.nikatru.com`, the dotted [ADR 079] host, was held
    // here for the cutover only and removed after the web build and a hosted e2e
    // run were green on the host above. wrangler publishes custom domains with
    // `override_scope: true`, so the deploy of this line detaches it.
    // `api.nikatru.com`, the pre-079 host, was held here for the cutover only and
    // removed after e2e run 34606369081 went green on the host above. wrangler publishes
    // custom domains with `override_scope: true`, so the deploy of this line detaches
    // it from this Worker.
  ],

  // 🔴 NO "r2_buckets". The per-app `EXPORTS` → `subly-exports` binding was
  // REMOVED on 2026-08-01 ([4]B-18, [4]B-1 limb 3). It had been bound since
  // 2026-07-17 and its ONLY occurrence in the entire TypeScript tree was its own
  // declaration in src/types.ts — no writer, no reader, on the live app. It is
  // also the exact per-app bucket `39-CHASSIS` cut 20 removed from the brick on
  // 2026-07-25: the template was fixed and the live app was not, and no guard
  // could see it because assert-clone-contract.mjs only ever inspects the
  // throwaway CI probe stamp. tooling/ci/assert-platform-register.mjs now
  // enumerates every binding in every wrangler config in the repo — this one and
  // the brick template included — and fails on any with no resolved reader.
  //
  // ⚠️ RENAME NOTE — `subly-exports` IS DELIBERATE, AND A RENAME SWEEP MUST
  // LEAVE IT. It is a history name: the bucket's real name when it was bound,
  // cited (not run) as `22e5d2b5:services/subly-api/wrangler.jsonc:52` (#110,
  // 2026-08-01). The sweep c92bfb80 (#567, 2026-09-09) rewrote it here to
  // `subscriptiontracker-exports`, a name this repository never bound.
  //
  // WHEN OBJECT STORAGE IS ACTUALLY NEEDED: ONE portfolio bucket, bound in
  // `services/platform`, addressed with an `<app_id>/` key prefix. Per-app
  // buckets multiply buckets, lifecycle rules and CORS policies by the number of
  // apps to store the same kind of blob.
  //
  // ⚠️ THE BUCKET IS GONE FROM THE ACCOUNT. A read-only `GET r2/buckets` at
  // 2026-09-21T22:20Z found neither name above, re-measured 2026-09-24T17:27:42Z
  // by ops-watch run 36034416847 (subly-* only).
  // `tooling/ops/check-retired-names-live.mjs` refuses a `subly`-named bucket on
  // every ops-watch run; nothing reads the account for any other name.
  //   ⏱ Until 2026-09-25 this said "THE BUCKET ITSELF IS STILL IN THE ACCOUNT"
  //   and that deleting it was the owner's; the reading above retired that.

  // ───────────────────────────────────────────────────────────────────────────
  // 🧪 env.sandbox — THE STORE CAPTURE'S API (Q11, row
  // O-STORE-CAPTURE-WRITES-UNATTRIBUTED-ROWS). `wrangler deploy --env sandbox`
  // deploys the script `subscriptiontracker-api-sandbox`, which answers on
  // https://subscriptiontracker-api-sandbox.nikatru.workers.dev and nowhere
  // else, so a store capture's demo rows land in a sandbox database instead of
  // production's. Deployed only by .github/workflows/deploy-sandbox.yml
  // (workflow_dispatch); deploy-workers deploys the top level above and never
  // this block.
  //
  // 🔴 EVERY KEY IS DECLARED; NONE IS LEFT TO INHERITANCE. Wrangler inherits
  // `routes`, `workers_dev` and `triggers` into an environment and does NOT
  // inherit `vars`, `d1_databases` or `kv_namespaces`. Without `routes: []`
  // this block would try to attach the production custom domain above to the
  // sandbox script. tooling/ci/assert-money-config.mjs limb 1c refuses a
  // sandbox environment that inherits a route, a cron or `workers_dev`, or that
  // binds a production database.
  //
  // No secrets: auth is ES256 through the project's JWKS
  // (services/_shared/src/auth.ts); SUPABASE_JWT_SECRET and GLITCHTIP_DSN are
  // optional. No ratelimits, services or R2: the top level binds none.
  "env": {
    "sandbox": {
      "routes": [],
      "workers_dev": true,
      "triggers": { "crons": [] },
      "vars": {
        // why: src/index.ts:158 reports it; every log line names the app by it.
        "APP_ID": "subscriptiontracker",
        // why: the SAME identity project as production (D1 identity option
        // (a)). A capture signs in as the e2e user, and src/middleware/auth.ts
        // verifies that token against this project's JWKS.
        "SUPABASE_URL": "https://lcrkiurkvzhkonjwhpiv.supabase.co",
        "API_VERSION": "v1",
        // why: src/middleware/cors.ts:40, as at the top level. The localhost
        // pattern a web capture sends is code (cors.ts:38), not this list.
        "ALLOWED_ORIGINS": "https://nikatru.com,https://subscriptiontracker-7qg.pages.dev",
        // why: src/routes/entitlements.ts:73 reads it and an absent world
        // answers 503; this deploy is the sandbox one ([5]M-12, limb 1b).
        "MONEY_ENVIRONMENT": "sandbox"
      },
      "d1_databases": [
        {
          // why: src/types.ts:13 — the capture's subscriptions and budgets are
          // written here. `subscriptiontracker_db_sandbox`, created 2026-09-24.
          "binding": "APP_DB",
          "database_name": "subscriptiontracker_db_sandbox",
          "database_id": "4e7c7730-3dc7-4004-9895-403b17702b91",
          "migrations_dir": "migrations"
        },
        {
          // why: src/types.ts:14 — entitlement reads. `platform_db_sandbox`,
          // migrated by services/platform's own env.sandbox (the sole applier),
          // so NO migrations_dir here, exactly as at the top level.
          "binding": "PLATFORM_DB",
          "database_name": "platform_db_sandbox",
          "database_id": "ead92001-03e1-4f71-9b92-c64963a24925"
        }
      ],
      "kv_namespaces": [
        // why: REQUIRED — src/types.ts:17, and src/middleware/auth.ts:91 calls
        // env.JWKS_CACHE.get unguarded. Its own namespace: production's holds
        // the same public keys and would work, but a production id in a
        // sandbox block is the shape this block exists to keep out.
        { "binding": "JWKS_CACHE", "id": "b2acb786d12f4e36b339dd19f8812bbe" }
      ]
    }
  }
}
