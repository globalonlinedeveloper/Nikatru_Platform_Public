{
  "name": "subscriptiontracker-api",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "dry-run": "wrangler deploy --dry-run",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply APP_DB --local",
    "db:migrate": "wrangler d1 migrations apply APP_DB --remote"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "sharp": ">=0.35.4"
  }
}
