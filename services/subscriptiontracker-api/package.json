{
  "name": "subscriptiontracker-api",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "dry-run": "wrangler deploy --dry-run",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply APP_DB --local",
    "db:migrate": "wrangler d1 migrations apply APP_DB --remote"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "sharp": ">=0.35.4",
    "undici": "7.29.1"
  }
}
