#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# pre-push — the FULL spec guards (~1 s), then the checks that cover what the push
# changed (affected-guards.mjs, 2026-09-30 block below), then a lock-free smoke of the ci-gate
# guards on each pushed commit (budget 60 s; see the 2026-09-24 block below).
#
# Why a separate full tier exists at all: it is where a guard too slow for every
# commit goes. `assert-enforcers-exist` lived here at 10.9 s, 94% of the total —
# on every commit that is the shape of hook people disable within a week, and this
# corpus has already written that lesson down about a 10-minute one.
#
# ⚠️ 2026-08-15 — THAT GUARD RETIRED WITH THE PROSE CORPUS IT READ, so the slow
# tier is empty today and --full selects the same set as --fast. Nothing here
# changes: --full is a superset by construction, so the first slow guard added to
# spec-guards.mjs is picked up by this hook with no edit.
#
# See pre-commit for why no status is ever read across a pipeline.
#
# 🔴 2026-09-24 — AND THEN A SMOKE OF THE ci-gate GUARDS, ON EACH PUSHED COMMIT
# (O-PRE-PUSH-RUNS-NO-CI-GATE-LEG). The spec guards read the private corpus, and
# no CI job can; of the guards ci-gate needs, this hook ran only the few that
# spec-guards also lists, so a guard the push turned red was usually first seen in
# CI, ~6 minutes later. After the spec guards pass,
# this hook runs `preflight.mjs --smoke --sha <sha>` once for every distinct
# commit the push sends (git names them on stdin; a deletion sends none). It
# judges a checkout of that commit, not the working tree, and takes no machine
# lock. Its budget is NIKATRU_SMOKE_BUDGET_S, default 60 s. It ends with the
# verdict line and a NOT CI-GATE line saying what it did not cover. A red that
# the commit caused refuses the push; exit 2 (COVERAGE LOST) refuses it too.
# ─────────────────────────────────────────────────────────────────────────────
set -u

# ── THIS checkout's hook, never another tree's (⏱ 2026-10-01, #1097 review minor 6) ──
# git runs the hook it finds through core.hooksPath. When that value is ABSOLUTE,
# or a lane worktree under .worktrees/ otherwise resolves it to the MAIN
# checkout's .githooks/, every path below that is derived from `$0` lands in the
# main checkout: its OLD guards judged this branch, and "hooks green" meant main.
# So the hook first asks git which tree it was invoked in
# (`git rev-parse --show-toplevel`) and, when that tree is a checkout of this
# repo carrying its own copy of this hook, hands over to that copy once. From
# then on `$0` is the invoking tree's, and so is every guard it runs. `exec`
# keeps stdin, so the ref lines git feeds a pre-push hook reach the copy it
# hands over to.
# A tree with no tooling/scripts/spec-guards.mjs (the private corpus, which
# shares these hooks through the pinned runner) is not this repo and keeps the
# hook it was given. NIKATRU_HOOK_OWN_TREE makes the hand-over happen at most once.
if [ -z "${NIKATRU_HOOK_OWN_TREE:-}" ]; then
  OWN_TOP=$(git rev-parse --show-toplevel 2>/dev/null) || OWN_TOP=''
  if [ -n "$OWN_TOP" ] && [ -f "$OWN_TOP/tooling/scripts/spec-guards.mjs" ] && [ -f "$OWN_TOP/.githooks/pre-push" ]; then
    RUNNING_DIR=$(cd -P "$(dirname "$0")" 2>/dev/null && pwd)
    OWN_DIR=$(cd -P "$OWN_TOP/.githooks" 2>/dev/null && pwd)
    if [ -n "$OWN_DIR" ] && [ "$RUNNING_DIR" != "$OWN_DIR" ]; then
      echo "pre-push: this hook is $0, outside the tree git invoked it in; running $OWN_DIR/pre-push instead, so this branch's own guards judge it." >&2
      NIKATRU_HOOK_OWN_TREE=1
      export NIKATRU_HOOK_OWN_TREE
      exec sh "$OWN_DIR/pre-push" "$@"
    fi
  fi
fi

# ── Self-advance: the pinned runner moves to origin/main BEFORE it runs ─────────
# ⏱ 2026-09-24 — the same block as pre-commit, for the same reason; read it there.
# `exec` keeps stdin, so the ref lines git feeds a pre-push hook reach the re-run.
ADVANCER="$(dirname "$0")/../tooling/scripts/install-hooks.mjs"
if [ -z "${NIKATRU_RUNNER_ADVANCED:-}" ] && [ -f "$ADVANCER" ] && command -v node >/dev/null 2>&1; then
  node "$ADVANCER" --advance-runner
  adv=$?         # captured immediately
  if [ "$adv" -eq 3 ]; then
    NIKATRU_RUNNER_ADVANCED=1
    export NIKATRU_RUNNER_ADVANCED
    exec sh "$0" "$@"
  fi
  if [ "$adv" -ne 0 ]; then
    echo "pre-push: the pinned hook runner is off origin/main and was not advanced (exit $adv). Push refused." >&2
    exit "$adv"
  fi
fi

# The pushed refs arrive on stdin, one `<local ref> <local sha> <remote ref> <remote sha>`
# per line. Read them HERE: after the self-advance block, whose `exec` re-run must
# still find them on stdin, and before the spec guards or any other child runs.
PUSHED=$(cat)

# 🔴 2026-08-18 — same repair as pre-commit, for the same measured reason: after the
# corpus became a sibling repo, every candidate below was written from the pre-move
# layout and none of them resolved from it. `$0` is the path git invokes this hook
# by, so `<hooks dir>/../tooling/…` finds the runner from any repo pointed here. The
# legacy candidates stay, below it, for pre-move checkouts.
RUNNER=''
for c in \
  "$(dirname "$0")/../tooling/scripts/spec-guards.mjs" \
  "tooling/scripts/spec-guards.mjs" \
  "../../tooling/scripts/spec-guards.mjs" \
  "../tooling/scripts/spec-guards.mjs"
do
  if [ -f "$c" ]; then RUNNER="$c"; break; fi
done

if [ -z "$RUNNER" ]; then
  echo "pre-push: spec-guards.mjs not found from $(pwd). Refusing." >&2
  echo "  hook invoked as: $0   (so the hooks directory is $(dirname "$0"))" >&2
  echo "  Re-install with: node tooling/scripts/install-hooks.mjs" >&2
  exit 1
fi

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node is not on PATH, so the spec guards did not run. Refusing." >&2
  exit 1
fi

echo "pre-push: running the full spec guards…"
node "$RUNNER" --full
code=$?

# Worded apart for the reason pre-commit gives: 2 is "could not check from here",
# any other non-zero is a finding. Each names the fix, not a way past the hook.
if [ "$code" -eq 2 ]; then
  echo "" >&2
  echo "pre-push: the spec guards could not run from this checkout (exit 2). Push refused." >&2
  echo "  runner: $RUNNER" >&2
  echo "  Read the first CANNOT RUN or ERR line above: it names what refused. A missing anchor or" >&2
  echo "  corpus is about where you push from, not what: push from a worktree under" >&2
  echo "  Projects/.worktrees/. A refusal is never a reason to push with --no-verify." >&2
  exit "$code"
fi
if [ "$code" -ne 0 ]; then
  echo "" >&2
  echo "pre-push: the spec guards are not clean (exit $code). Push refused." >&2
  echo "  Read the first FAIL line above, fix what it names, commit the fix and push again." >&2
  echo "  A red hook is fixed, never skipped: never push with --no-verify." >&2
  exit "$code"
fi

# ── the ci-gate smoke (2026-09-24, see the header) ───────────────────────────
PREFLIGHT="$(dirname "$RUNNER")/preflight.mjs"
if [ ! -f "$PREFLIGHT" ]; then
  echo "pre-push: preflight.mjs not found beside $RUNNER, so the ci-gate smoke did not run. Refusing." >&2
  exit 1
fi

SHAS=''
for sha in $(printf '%s\n' "$PUSHED" | cut -d' ' -f2); do
  case "$sha" in
    *[!0]*) ;;       # a real commit
    *) continue ;;   # all zeros: a deletion, nothing to smoke
  esac
  case " $SHAS " in
    *" $sha "*) ;;   # two refs, one commit: smoke it once
    *) SHAS="$SHAS $sha" ;;
  esac
done

if [ -z "$SHAS" ]; then
  echo "pre-push: no commit to smoke (the push only deletes, or git named no ref on stdin), so no ci-gate smoke."
  exit 0
fi

# ── the checks that cover what the push changed (2026-09-30) ────────────────
# Lanes stopped running the whole-branch preflight on 2026-09-25 and were to check
# their TOUCHED files; nothing enforced it, and 23 of the first failing jobs of
# 125 PR runs (2026-09-29..30) were the lane's own change. affected-guards.mjs
# selects every guard, guard test, Dart package gate and Worker suite whose subject
# covers a path the pushed commit changed, runs them in parallel under a budget
# (NIKATRU_AFFECTED_BUDGET_S, default 240 s), and prints each with its exit code and
# the wall time. It judges THIS working tree, so the pushed commit must be HEAD here.
# Exit 1 (a finding) and exit 2 (COVERAGE LOST: an unmapped path, a check that could
# not run) both refuse the push.
# The ONE escape, for a push whose only purpose is to reach CI for a Linux-only
# check: NIKATRU_SKIP_FOR_CI=<check id>[,<id>] NIKATRU_SKIP_FOR_CI_REASON="<why>".
# It skips only the checks it names, each must be one this run selected, and every
# use is printed and appended to <git common dir>/affected-guards-skips.log.
AFFECTED="$(dirname "$RUNNER")/affected-guards.mjs"
if [ ! -f "$AFFECTED" ]; then
  echo "pre-push: affected-guards.mjs not found beside $RUNNER, so the affected checks did not run. Refusing." >&2
  exit 1
fi
TOP=$(git rev-parse --show-toplevel)
for sha in $SHAS; do
  echo "pre-push: running the checks that cover what $sha changed (budget ${NIKATRU_AFFECTED_BUDGET_S:-240} s)…"
  node "$AFFECTED" --root "$TOP" --sha "$sha"
  code=$?
  if [ "$code" -ne 0 ]; then
    echo "" >&2
    echo "pre-push: the affected checks of $sha are not clean (exit $code). Push refused." >&2
    echo "  Read the first FINDING, UNMAPPED or COVERAGE LOST line above, fix what it names, commit the fix and push again." >&2
    echo "  Only a Linux-only check may be sent to CI instead, by name: NIKATRU_SKIP_FOR_CI=<id> NIKATRU_SKIP_FOR_CI_REASON=\"<why>\"." >&2
    echo "  A red hook is fixed, never skipped: never push with --no-verify." >&2
    exit "$code"
  fi
done

for sha in $SHAS; do
  echo "pre-push: smoking the ci-gate guards on $sha (no machine lock; budget ${NIKATRU_SMOKE_BUDGET_S:-60} s)…"
  node "$PREFLIGHT" --smoke --sha "$sha"
  code=$?
  if [ "$code" -ne 0 ]; then
    echo "" >&2
    echo "pre-push: the ci-gate smoke of $sha is not clean (exit $code). Push refused." >&2
    echo "  Read the first REGRESSION or COVERAGE LOST line above, fix what it names, commit the fix and push again." >&2
    echo "  A red hook is fixed, never skipped: never push with --no-verify." >&2
    exit "$code"
  fi
done

exit 0
