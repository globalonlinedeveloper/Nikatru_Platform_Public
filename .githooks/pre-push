#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# pre-push — the FULL spec guards (~1 s).
#
# Why a separate full tier exists at all: it is where a guard too slow for every
# commit goes. `assert-enforcers-exist` lived here at 10.9 s, 94% of the total —
# on every commit that is the shape of hook people disable within a week, and this
# corpus has already written that lesson down about a 10-minute one.
#
# ⚠️ 2026-08-15 — THAT GUARD RETIRED WITH THE PROSE CORPUS IT READ, so the slow
# tier is empty today and --full selects the same set as --fast. Nothing here
# changes: --full is a superset by construction, so the first slow guard added to
# spec-guards.mjs is picked up by this hook with no edit.
#
# See pre-commit for why no status is ever read across a pipeline.
# ─────────────────────────────────────────────────────────────────────────────
set -u

# ── Self-advance: the pinned runner moves to origin/main BEFORE it runs ─────────
# ⏱ 2026-09-24 — the same block as pre-commit, for the same reason; read it there.
# `exec` keeps stdin, so the ref lines git feeds a pre-push hook reach the re-run.
ADVANCER="$(dirname "$0")/../tooling/scripts/install-hooks.mjs"
if [ -z "${NIKATRU_RUNNER_ADVANCED:-}" ] && [ -f "$ADVANCER" ] && command -v node >/dev/null 2>&1; then
  node "$ADVANCER" --advance-runner
  adv=$?         # captured immediately
  if [ "$adv" -eq 3 ]; then
    NIKATRU_RUNNER_ADVANCED=1
    export NIKATRU_RUNNER_ADVANCED
    exec sh "$0" "$@"
  fi
  if [ "$adv" -ne 0 ]; then
    echo "pre-push: the pinned hook runner is off origin/main and was not advanced (exit $adv). Push refused." >&2
    exit "$adv"
  fi
fi

# 🔴 2026-08-18 — same repair as pre-commit, for the same measured reason: after the
# corpus became a sibling repo, every candidate below was written from the pre-move
# layout and none of them resolved from it. `$0` is the path git invokes this hook
# by, so `<hooks dir>/../tooling/…` finds the runner from any repo pointed here. The
# legacy candidates stay, below it, for pre-move checkouts.
RUNNER=''
for c in \
  "$(dirname "$0")/../tooling/scripts/spec-guards.mjs" \
  "tooling/scripts/spec-guards.mjs" \
  "../../tooling/scripts/spec-guards.mjs" \
  "../tooling/scripts/spec-guards.mjs"
do
  if [ -f "$c" ]; then RUNNER="$c"; break; fi
done

if [ -z "$RUNNER" ]; then
  echo "pre-push: spec-guards.mjs not found from $(pwd). Refusing." >&2
  echo "  hook invoked as: $0   (so the hooks directory is $(dirname "$0"))" >&2
  echo "  Re-install with: node tooling/scripts/install-hooks.mjs" >&2
  exit 1
fi

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node is not on PATH, so the spec guards did not run. Refusing." >&2
  exit 1
fi

echo "pre-push: running the full spec guards…"
node "$RUNNER" --full
code=$?

# Worded apart for the reason pre-commit gives: 2 is "could not check from here",
# any other non-zero is a finding. Each names the fix, not a way past the hook.
if [ "$code" -eq 2 ]; then
  echo "" >&2
  echo "pre-push: the spec guards could not run from this checkout (exit 2). Push refused." >&2
  echo "  runner: $RUNNER" >&2
  echo "  Read the first CANNOT RUN or ERR line above: it names what refused. A missing anchor or" >&2
  echo "  corpus is about where you push from, not what: push from a worktree under" >&2
  echo "  Projects/.worktrees/. A refusal is never a reason to push with --no-verify." >&2
  exit "$code"
fi
if [ "$code" -ne 0 ]; then
  echo "" >&2
  echo "pre-push: the spec guards are not clean (exit $code). Push refused." >&2
  echo "  Read the first FAIL line above, fix what it names, commit the fix and push again." >&2
  echo "  A red hook is fixed, never skipped: never push with --no-verify." >&2
  exit "$code"
fi

exit 0
