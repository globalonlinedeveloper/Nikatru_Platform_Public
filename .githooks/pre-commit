#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# pre-commit — the FAST spec guards (~0.5 s).
#
# Installed by:  node tooling/scripts/install-hooks.mjs
# Shared by the public repo AND Private/, which is why the runner is
# located by search rather than by a fixed relative path.
#
# 🔴 NO PIPELINES IN A DECISION PATH. `cmd | grep …; if [ $? ]` reports the LAST
# stage's status, so a failing guard reads as success. This corpus has been bitten
# by that twice — once while testing a guard written to catch exactly that trap.
# Every status below is captured on its own line, immediately, before anything
# else runs.
# ─────────────────────────────────────────────────────────────────────────────
set -u

# ── Self-advance: the pinned runner moves to origin/main BEFORE it runs ─────────
# ⏱ 2026-09-24 (O-PRIVATE-HOOK-RUNNER-FOLLOWS-A-LIVE-BRANCH). The private corpus's
# core.hooksPath points at ONE detached worktree of this repo pinned to origin/main
# (`install-hooks.mjs --pin-private`). When this file runs FROM that worktree and a
# fetch has moved origin/main, `--advance-runner` checks the worktree out at the new
# origin/main (the LOCAL ref: no fetch, no network) and exits 3, and this file is
# re-executed ONCE, so the hook text and the runner that judge the commit are the
# ones origin/main carries. From any other tree it exits 0 before touching git.
# The checkout is done by node, never by `git` here: git exports GIT_INDEX_FILE
# (and can export GIT_DIR) into this process, and a `git -C <runner> checkout` that
# inherits it treats the CORPUS's index as the runner's. Measured in a scratch pair:
# such a checkout read the corpus's entries as local edits and refused. node goes
# through repo-git.mjs, which deletes those variables first.
# NIKATRU_RUNNER_ADVANCED is what makes it once: the re-executed copy skips this.
ADVANCER="$(dirname "$0")/../tooling/scripts/install-hooks.mjs"
if [ -z "${NIKATRU_RUNNER_ADVANCED:-}" ] && [ -f "$ADVANCER" ] && command -v node >/dev/null 2>&1; then
  node "$ADVANCER" --advance-runner
  adv=$?         # captured immediately
  if [ "$adv" -eq 3 ]; then
    NIKATRU_RUNNER_ADVANCED=1
    export NIKATRU_RUNNER_ADVANCED
    exec sh "$0" "$@"
  fi
  if [ "$adv" -ne 0 ]; then
    echo "pre-commit: the pinned hook runner is off origin/main and was not advanced (exit $adv). Commit refused." >&2
    exit "$adv"
  fi
fi

# 🔴 2026-08-18 — THE CORPUS BECAME A SIBLING AND THIS SEARCH LIST STOPPED REACHING
# THE RUNNER. The three relative candidates below are all written from the PRE-MOVE
# layout, where the corpus was `<public repo>/Private` and `../tooling/scripts/…`
# therefore landed in the public repo. From the sibling
# `../Project_Cross_Platform_Apps_Private` they resolve to `Projects/tooling/…` and
# `Documents/Claude/tooling/…`, neither of which exists — measured on the day, not
# reasoned about: the hook fired, found nothing, and refused with exit 1.
#
# That refusal is the fail-closed branch working exactly as written, and it is why
# this was a loud breakage rather than a silent pass. But a hook that can only ever
# refuse is not a guard either, so the locator is now anchored to something that
# moves WITH the hooks instead of guessing at the caller's depth: `$0`, the path git
# invokes this file by, which is derived from `core.hooksPath` and so is correct from
# any repo pointed at this directory. `<hooks dir>/../tooling/scripts/spec-guards.mjs`
# is the runner's position relative to the hooks, and that relationship is a fact
# about THIS repo's layout — the one thing a file inside it may assume.
#
# The three legacy candidates are KEPT, and kept BELOW the derived one, so a checkout
# still sitting in a pre-move layout resolves exactly as it did before.
RUNNER=''
for c in \
  "$(dirname "$0")/../tooling/scripts/spec-guards.mjs" \
  "tooling/scripts/spec-guards.mjs" \
  "../../tooling/scripts/spec-guards.mjs" \
  "../tooling/scripts/spec-guards.mjs"
do
  if [ -f "$c" ]; then RUNNER="$c"; break; fi
done

if [ -z "$RUNNER" ]; then
  echo "pre-commit: spec-guards.mjs not found from $(pwd)." >&2
  echo "  hook invoked as: $0   (so the hooks directory is $(dirname "$0"))" >&2
  echo "  A hook that cannot find its runner has checked nothing. Refusing." >&2
  echo "  Re-install with: node tooling/scripts/install-hooks.mjs" >&2
  exit 1
fi

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node is not on PATH, so the spec guards did not run." >&2
  echo "  Refusing rather than passing — an unrun check is not a clean one." >&2
  exit 1
fi

node "$RUNNER" --fast
code=$?          # captured immediately; nothing may run between these two lines

if [ "$code" -ne 0 ]; then
  echo "" >&2
  echo "pre-commit: the spec guards are not clean. Commit refused." >&2
  echo "  Deliberate override:  git commit --no-verify   (and say why in the message)" >&2
  exit "$code"
fi

# ── Indian PII on the STAGED diff — O-PAN-IN-PUBLIC-HISTORY ──────────────────
# The proprietor's real PAN reached this PUBLIC repo in a test fixture
# (commit 82a309dc, 2026-07-21). CI's gitleaks job has carried the
# nikatru-india-pan / -gstin / -aadhaar rules since, but CI runs AFTER the push:
# by then the value is public. This runs the SAME rules, from the same
# .gitleaks.toml, before the commit exists.
# Only where that config exists — the public repo. Private shares this hook and
# holds business identity by design; it has no .gitleaks.toml.
TOP=$(git rev-parse --show-toplevel)
if [ -f "$TOP/.gitleaks.toml" ]; then
  if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks is not on PATH, so the staged diff was not scanned for PAN/GSTIN/Aadhaar." >&2
    echo "  Refusing rather than passing — an unrun check is not a clean one. Install the gitleaks version tooling/versions.json pins (ci.yml installs the same pin)." >&2
    exit 1
  fi
  # O-HOOK-GITLEAKS-PIN-UNREAD — the pin is READ, never restated here. A different
  # gitleaks than CI's can load the same .gitleaks.toml and match differently, so a
  # clean local scan would be evidence about some other scanner. Both reads stay
  # INSIDE this block: Private shares the hook and has no tooling/versions.json.
  want=$(node -p "require('$TOP/tooling/versions.json').gitleaks")
  code=$?        # captured immediately
  if [ "$code" -ne 0 ] || [ -z "$want" ] || [ "$want" = "undefined" ]; then
    echo "pre-commit: could not read the gitleaks pin from tooling/versions.json (exit $code, read '$want'). Commit refused." >&2
    exit 1
  fi
  got=$(gitleaks version)
  code=$?        # captured immediately
  if [ "$code" -ne 0 ] || [ -z "$got" ]; then
    echo "pre-commit: \`gitleaks version\` failed (exit $code), so the installed scanner is unknown. Commit refused." >&2
    exit 1
  fi
  got=${got#v}
  if [ "$got" != "$want" ]; then
    echo "pre-commit: gitleaks $got is installed, but tooling/versions.json pins gitleaks $want. Commit refused." >&2
    echo "  Install gitleaks $want — the scan must be CI's scanner, or a clean result here proves nothing about CI's." >&2
    exit 1
  fi
  gitleaks git --pre-commit --staged --no-banner --redact --config "$TOP/.gitleaks.toml" "$TOP"
  leak=$?        # captured immediately
  if [ "$leak" -ne 0 ]; then
    echo "" >&2
    echo "pre-commit: gitleaks found a secret or Indian PII in the staged diff (exit $leak). Commit refused." >&2
    echo "  Remove it from the change. A PAN, GSTIN or Aadhaar never belongs in this public repo, fixtures included." >&2
    exit "$leak"
  fi
fi

exit 0
